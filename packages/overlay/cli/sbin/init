#!/bin/sh
# A20OS stage-2 init for the cli world.  The kernel already mounted
# devtmpfs/proc/sysfs under /extra before the chroot, so /dev /proc /sys are
# live here. BusyBox init owns reaping, respawn and shutdown; getty establishes
# the console session before cli-session queries its size and execs zsh.
# The kernel's inherited stdio alone does not establish a controlling tty.

export HOME=/root
export SHELL=/bin/zsh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# xterm-256color rather than the vt100 the other overlays use: QEMU's -serial
# stdio is a byte pipe to the operator's real terminal, so zsh gets colours and
# full line editing instead of a monochrome prompt.  ncurses-terminfo in the
# world is what makes the TERM entry resolvable.  Override in ~/.zshrc if the
# host terminal is not xterm-compatible.
export TERM=${TERM:-xterm-256color}

# Finish runtime mounts before starting the upstream PID 1 supervisor.
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /dev/shm 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

# PID 1 stays a supervisor; the console shell is a getty child session.
exec /bin/busybox init
