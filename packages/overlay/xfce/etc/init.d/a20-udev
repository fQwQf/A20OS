#!/sbin/openrc-run
description="Device event daemon"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=30
command="/sbin/udevd"
pidfile="/run/a20-udev.pid"
output_log="/var/log/a20/udev-startup.log"
error_log="/var/log/a20/udev-startup.log"
retry="TERM/5/KILL/2"
depend() { need a20-platform; }
start_post() {
    local i=0
    while [ ! -e /run/udev/control ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i+1)); done
    [ -e /run/udev/control ] || return 1
    udevadm trigger --action=add
    timeout 5 udevadm settle || true
}
