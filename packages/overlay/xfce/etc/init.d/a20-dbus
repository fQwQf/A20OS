#!/sbin/openrc-run
description="System D-Bus"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=30
command="/usr/bin/dbus-daemon"
command_args="--system --nofork --nopidfile"
pidfile="/run/a20-dbus.pid"
output_log="/var/log/a20/dbus-startup.log"
error_log="/var/log/a20/dbus-startup.log"
retry="TERM/5/KILL/2"
depend() { need a20-platform; }
