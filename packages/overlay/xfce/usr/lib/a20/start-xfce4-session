#!/bin/sh
# A20OS XFCE Wayland session: dbus session bus + labwc compositor.  labwc's
# autostart file (root/.config/labwc/autostart) launches xfsettingsd,
# xfdesktop, xfce4-panel and thunar once the compositor is up.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=XFCE
export XDG_SESSION_DESKTOP=xfce
export XDG_CONFIG_DIRS=/etc/xdg
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export NO_AT_BRIDGE=1
export XMODIFIERS=@im=ibus
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
export XCURSOR_PATH=/usr/share/icons:/usr/share/pixmaps
export SDL_VIDEODRIVER=wayland
# The existing ALSA default routes to hw:0. Keep failed hardware visible and
# honour an operator's explicit backend instead of silently discarding sound.
export SDL_AUDIODRIVER="${SDL_AUDIODRIVER:-alsa}"
# SDL2 没有 GL 可用，强制软件渲染器（ffplay 用它出画）
export SDL_RENDER_DRIVER=software
export SEATD_VTBOUND=0
# runuser -l resets the inherited environment, so the session re-establishes
# the full home/XDG set here.  xfconfd/dconf need explicit config dirs or
# they compute a NULL path and die before owning org.xfce.Xfconf.
export HOME=/root
export XDG_RUNTIME_DIR=/run/user/0
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
# session-start evaluates it when it execs the compositor.
export LABWC_DEBUG

# A20OS exposes its selected display (virtio-gpu or retained GOP/DT framebuffer)
# as /dev/dri/card0 via its kernel devfs; the udev
# database does not describe it, so pin the KMS device explicitly (wlroots
# opens WLR_DRM_DEVICES directly instead of relying on udev enumeration).
export WLR_DRM_DEVICES=/dev/dri/card0
export WLR_DRM_NO_ATOMIC=1
export WLR_NO_HARDWARE_CURSORS=1

# Choose GLES when the device negotiated host 3D, otherwise use pixman.
# Retained firmware displays use the same KMS/dumb-buffer path; they do not
# need an Intel GPU driver, a separate fbdev terminal, or EGL/GBM rendering.
# An explicit operator choice remains authoritative.
if [ -z "${A20_RENDERER:-}" ]; then
    A20_RENDERER=$(/usr/lib/a20/select-renderer) || A20_RENDERER=pixman
fi
export WLR_RENDERER="$A20_RENDERER"
echo "a20: desktop renderer=$WLR_RENDERER device=$WLR_DRM_DEVICES audio=$SDL_AUDIODRIVER" >&2

# Input devices are published as /dev/input/event* with /sys/devices/virtual/
# input/* nodes, and the uevent stream carries a real per-event SEQNUM so
# eudev's worker runs the rules and persists ID_INPUT_* into its database.
# libinput's udev backend now enumerates the evdev nodes through seatd.
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME/dconf" \
    "$XDG_CONFIG_HOME/xfce4/xfconf/xfce-perchannel-xml" \
    "$XDG_DATA_HOME" "$XDG_CACHE_HOME"
chmod 0700 "$XDG_RUNTIME_DIR"

# The session bus and compositor share one lifetime.  session-start publishes
# org.xfce.SessionManager on that bus first, which is what makes the panel's
# actions menu able to restart or power off the machine.
exec dbus-run-session -- /usr/lib/a20/session-start
