# xfce profile for x86_64 — XFCE desktop via Alpine upstream packages
a20-base
a20-drivers
# NOTE: no alpine-base here — a20-base already owns etc/os-release etc/,
# and apk treats the overlap as fatal. The overlay supplies etc/passwd and
# etc/group instead.
musl
busybox
busybox-extras
bash
ca-certificates
# X server + init
xinit
xorg-server
xf86-video-fbdev
xf86-input-libinput
# udev database: libinput enumerates input devices through udev
eudev
# XFCE desktop
xfce4
xfce4-terminal
xfce4-power-manager
xfce4-notifyd
xfce4-taskmanager
xfce4-whiskermenu-plugin
xfce4-clipman-plugin
xfce4-places-plugin
xfce4-systemload-plugin
xfce4-cpugraph-plugin
xfce4-netload-plugin
xfce4-smartbookmark-plugin
xfce4-genmon-plugin
xfce4-fsguard-plugin
xfce4-calculator-plugin
xfce4-mpc-plugin
xfce4-stopwatch-plugin
xfce4-verve-plugin
xfce4-timer-plugin
# Fonts
font-noto
font-dejavu
# Utilities
xdg-user-dirs
xdg-utils
hicolor-icon-theme
adwaita-icon-theme
