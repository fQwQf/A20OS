gst-plugins-bad
gst-plugins-ugly
gst-libav

# 网络
networkmanager
nm-applet

# 音频
pulseaudio
pavucontrol

# 其他
xdg-user-dirs
xdg-utils
hicolor-icon-theme
adwaita-icon-theme
papirus-icon-theme
