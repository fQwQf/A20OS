# xfce profile —— XFCE desktop via Alpine upstream packages
#
# 使用 Alpine 仓库中的 xfce4 包，配合 wayland/labwc 运行（与
# user/rootfs/alpine 的 distro 参考流程同栈；不采用本地魔改的 weston）。
# 需要网络拉取上游包。

a20-base
a20-drivers

# Alpine 基础
musl
busybox
ca-certificates

# 设备/登录/会话服务层（stage-2 init 依赖：dbus -> elogind -> seatd -> udevd）
dbus
dbus-x11
elogind
seatd
seatd-launch
eudev
polkit
runuser

# Wayland 合成器（labwc/wlroots）+ X 兼容层
wayland
labwc
xwayland

# XFCE 桌面
xfce4-session
xfce4-panel
xfdesktop
xfwm4
thunar
xfce4-terminal
xfce4-settings
xfce4-appfinder
xfce4-power-manager
xfce4-notifyd
xfce4-screensaver
xfce4-taskmanager
xfce4-whiskermenu-plugin
xfce4-clipman-plugin
xfce4-pulseaudio-plugin
xfce4-weather-plugin
xfce4-places-plugin
xfce4-systemload-plugin
xfce4-battery-plugin
xfce4-verve-plugin
xfce4-timer-plugin
xfce4-cpugraph-plugin
xfce4-netload-plugin
xfce4-smartbookmark-plugin
xfce4-genmon-plugin
xfce4-fsguard-plugin
xfce4-calculator-plugin
xfce4-mpc-plugin
xfce4-stopwatch-plugin
# 邮件提醒插件：Alpine v3.23 起 webmail-plugin 由 mailwatch-plugin 替代
xfce4-mailwatch-plugin
# 已在 Alpine v3.23 全架构下架（勿加回）：xfce4-eyes/gmail/indicator/kbdleds/
# quicklauncher/radio/shade/timeout/xfappfinder/datetime-plugin、ibus 系部分插件

# 输入法
ibus
ibus-rime

# 字体
font-noto
font-noto-cjk
font-noto-emoji
font-dejavu

# 媒体
ffmpeg
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
gst-libav

# 网络
networkmanager
network-manager-applet

# 音频
pulseaudio
pavucontrol

# 其他
xdg-user-dirs
xdg-utils
hicolor-icon-theme
adwaita-icon-theme
papirus-icon-theme
