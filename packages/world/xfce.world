# xfce profile —— XFCE desktop via Alpine upstream packages
#
# 使用 Alpine 仓库中的 xfce4 包，配合 wayland/labwc 运行（与
# user/rootfs/alpine 的 distro 参考流程同栈；不采用本地魔改的 weston）。
# 需要网络拉取上游包。

a20-base
a20-drivers

# Alpine 基础
musl
busybox
ca-certificates

# Shell 与系统信息工具（xfce4-terminal 默认 shell 走 /etc/passwd）
zsh
fastfetch

# 设备/登录/会话服务层（stage-2 init 依赖：dbus -> elogind -> seatd -> udevd）
dbus
dbus-x11
elogind
seatd
seatd-launch
eudev
polkit
runuser

# Wayland 合成器（labwc/wlroots）+ X 兼容层
wayland
labwc
xwayland

# XFCE 桌面
xfce4-session
xfce4-panel
xfdesktop
xfwm4
thunar
xfce4-terminal
xfce4-settings
xfce4-appfinder
xfce4-power-manager
xfce4-notifyd
xfce4-screensaver
xfce4-taskmanager
xfce4-whiskermenu-plugin
xfce4-clipman-plugin
xfce4-pulseaudio-plugin
xfce4-weather-plugin
xfce4-places-plugin
xfce4-systemload-plugin
xfce4-battery-plugin
xfce4-verve-plugin
xfce4-timer-plugin
xfce4-cpugraph-plugin
xfce4-netload-plugin
xfce4-smartbookmark-plugin
xfce4-genmon-plugin
xfce4-fsguard-plugin
xfce4-calculator-plugin
xfce4-mpc-plugin
xfce4-stopwatch-plugin
# 邮件提醒插件：Alpine v3.23 起 webmail-plugin 由 mailwatch-plugin 替代
xfce4-mailwatch-plugin
# 已在 Alpine v3.23 全架构下架（勿加回）：xfce4-eyes/gmail/indicator/kbdleds/
# quicklauncher/radio/shade/timeout/xfappfinder/datetime-plugin、ibus 系部分插件

# 输入法
ibus
ibus-rime

# 字体
font-noto
font-noto-cjk
font-noto-emoji
font-dejavu

# 媒体（播放器：parole 走 GStreamer，mpv 作为兜底/命令行播放）
ffmpeg
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
gst-libav
parole
mpv
# ffplay: ffmpeg 自带播放器，软件解码实测稳定（mpv 的 Lua 线程在 A20OS 上会偶发崩溃）
ffplay
# 缩略图服务（thunar/xfdesktop 通过 D-Bus 激活 org.freedesktop.thumbnails.Thumbnailer1）
tumbler

# JVM（Minecraft 等 Java 程序；openjdk21 在 x86_64/aarch64/riscv64 均有包。
# 注意 LWJGL 只提供 x86_64/aarch64 native，riscv64 跑不了 Minecraft）
openjdk21-jre
# LWJGL 的 Linux native 是 glibc 链接（DT_NEEDED 为 libc.so.6/libdl.so.2/
# libpthread.so.0），且上游不提供 musl 变体；本镜像是纯 musl，缺了它 JNI 层
# 无法 dlopen。gcompat 提供 glibc ABI 兼容层，是 Java + LWJGL 的前置包。
gcompat

# 图形 API：OpenGL / OpenGL ES / EGL / GBM（Mesa 软件渲染 llvmpipe + virgl）。
# 桌面合成器默认仍是 pixman；GL 客户端需要合成器用 GL 渲染器（见 docs）。
mesa
mesa-dri-gallium
mesa-gl
mesa-gles
mesa-egl
mesa-gbm
virglrenderer
# 诊断工具：glxinfo / eglinfo / glxgears / es2_info
mesa-utils
mesa-demos

# 网络
networkmanager
network-manager-applet

# 音频
pulseaudio
pavucontrol

# 其他
xdg-user-dirs
xdg-utils
hicolor-icon-theme
adwaita-icon-theme
papirus-icon-theme

# 壁纸：xfdesktop 4.20.1 的 Wayland backdrop 不绘制（见 docs/distro/known-issues.md），
# 用合成器层面的背景工具补上（挂 wlr-layer-shell 的 background 层）。
swaybg
