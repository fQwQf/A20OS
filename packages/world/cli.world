# cli profile —— 纯命令行 Alpine 工作站（无桌面）
#
# 目的：给 QEMU 上的 A20OS 一个**能用**的交互式命令行环境。既有的
# server world 是刻意的"最小服务器形态"（busybox ash + dropbear + chrony），
# 交互体验上等于没有工具链；devtools / devel world 是编译器验证用的，
# 也不以日常使用为目标。这里按"一台正常的 Linux 命令行机器"来配。
#
#   tools/a20 run cli-riscv64
#
# 配套 packages/overlay/cli/（a20-distro 标记 + stage-2 init + 账号文件），
# 内核把镜像挂到 /extra，A20OS 的 init 检测到标记后 chroot 进去 exec
# /sbin/init。CLI 交给 BusyBox init/getty，由独立控制台会话启动 zsh 登录 shell。
#
# 首次组镜像需要网络拉取上游包（默认 USTC 镜像源），之后走 build/cache/apk
# 缓存。上游是 Alpine v3.23 的 main（见 tools/packaging/mkrootfs.py 的
# DEFAULT_ALPINE_VERSION / DEFAULT_ALPINE_MIRROR），镜像源可用
# ALPINE_MIRROR_ROOT 覆盖；tools/pkg.py 的 image-world 目前不透传该开关，
# 需要换源时直接调 tools/packaging/mkrootfs.py --alpine-mirror。
#
# 全部包都在 Alpine main 里，四个 hosted 架构（riscv64/aarch64/x86_64/
# loongarch64）都有——刻意不碰 community，避免某个架构缺包时整个镜像组不出来。

# Alpine 基础。musl 是运行时，busybox 提供 /bin/sh 与一批内建命令，
# ca-certificates 是 curl/wget/git 走 HTTPS 的前提。
musl
busybox
ca-certificates

# shell：zsh 是交互 shell（overlay 的 /sbin/init 直接 exec 它），
# bash 留给脚本与习惯用 bash 的场景。
zsh
bash

# GNU 工具链。busybox 自带的同名命令参数子集不全（例如 find 的
# -printf、grep 的 -P、sed 的 -i 细节），装了这几个之后 PATH 里
# /usr/bin 的 GNU 版本会盖过 busybox 的内建命令。
coreutils
findutils
grep
sed
gawk
diffutils
which
file
tree
less

# 进程与系统观察。
procps
util-linux
psmisc
lsof
strace
htop
tmux

# 编辑器。
vim
nano

# 归档与压缩。
tar
gzip
bzip2
xz
zstd
zip
unzip

# 文本/数据。
jq

# 网络。curl/wget 走 slirp 出网；openssh-client 是 ssh/scp/sftp；
# iproute2 + iputils 给 ip/ping/ss，bind-tools 给 dig/nslookup。
# RV64 SMP2 的本地 HTTP 与 ip 接口/地址/路由查询已通过；
# dig/nslookup 的本地 UDP DNS 与 ICMP 错误队列检查通过，范围见文末。
curl
wget
openssh-client
iproute2
iputils
bind-tools
rsync
socat

# 终端能力库：zsh 的补全、vim 的配色、tmux 的 TERM 都要 terminfo，
# 缺了表现为"终端一片黑白 + 方向键打出转义序列"。
ncurses-terminfo-base
ncurses-terminfo

# 存储工具：guest 里能自己 fsck / 打盘，调试第二块盘时用得上。
e2fsprogs
dosfstools

# 语言与时间。
python3
py3-pip
tzdata

# 版本控制。
git

# 手册：man 本体（mandoc）+ 页面内容。
mandoc
man-pages

# ---------------------------------------------------------------------------
# 当前运行状态（RV64 QEMU virt / ABI=both / SMP2 / BSD，2026-11-16）
# ---------------------------------------------------------------------------
#
#   * BusyBox init 为 PID 1，getty 建立控制终端后由 cli-session exec zsh。
#     两个先后会话均完成 120x40 尺寸查询、termios 恢复和孤儿回收；shell
#     exit 后 respawn 新会话，普通 poweroff 经 init 停止进程后自然关机。
#   * console-size 的读取保持在前台组；交互 resize-console 函数会在当前
#     zsh 更新 COLUMNS/LINES。无宿主窗口尺寸事件时需手动重新查询。
#   * bash/zsh 的管道、命令替换、后台等待及退出码通过；NPROC 默认无限值
#     的错误已修复，无特权零上限拒绝 fork。
#   * tmpfs 挂载、文件写读和卸载通过；当前进程及私有 namespace/chroot
#     子进程的 procfs 挂载视图通过。
#   * ip link/address/route、本地 HTTP 和 dig/nslookup UDP DNS 查询通过；
#     IPv4/IPv6 回环 ICMP 错误队列、POLLERR 与错误消费通过。
#
# 控制台契约：docs/zh/kernel/linux-abi/cli-console.md。
# 实际命令、证据及保留范围：docs/zh/kernel/linux-abi/application-contracts.md。
# 原始运行：build/evidence/v1-closeout-20261116/cli-application/ 与 cli-console/。
# 这些定向结果不扩大为全部终端、应用或平台的正式支持认证。
# HISTFILE=/dev/shm 与关闭逐命令历史同步是当前 shell 偏好；旧 ext4 orphan
# EOPNOTSUPP 不再列为当前缺陷。其它恢复边界按 ext4-orphan-gap.md 跟踪。
