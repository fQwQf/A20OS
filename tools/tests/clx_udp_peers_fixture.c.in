/* Production UDP peer table/poller; deterministic socket, clock and event seams. */
#include <assert.h>
#include <errno.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>

/* PRODUCTION_CONSTANTS */
/* PRODUCTION_BITMAP_SIZE */
#define A20_ERR_INVALID_ARGUMENT 1
#define A20_ERR_NO_SPACE 2
#define A20_ERR_IO 3
#define AF_INET 2
#define MSG_DONTWAIT 64
#define TICKS_PER_SEC 1000u
#define MS_TO_TICKS(x) (x)
typedef struct {
    uint8_t bytes[16];
} a20_node_id_t;
typedef unsigned spinlock_t;
typedef struct {
    unsigned unused;
} net_socket_t;
typedef struct {
    uint16_t sin_family, sin_port;
    uint32_t sin_addr;
} net_sockaddr_in_t;
/* PRODUCTION_PEER_TYPE */
static spinlock_t g_udp_lock;
static clx_udp_peer_t g_udp_peers[CLX_LIMIT_ROUTES];
static uint64_t g_udp_active[CLX_UDP_PEER_WORDS];
static net_socket_t socket, *g_udp_socket;
static uint8_t g_udp_rx[1501];
static uint64_t now, nonce;
static unsigned held, locks, sends, suspects, downs, receives, snapshot_hook;
static int start_error;
static uint8_t sent_type[CLX_LIMIT_ROUTES], sent_nh[CLX_LIMIT_ROUTES][6];
static uint32_t sent_challenge[CLX_LIMIT_ROUTES];
static void after_snapshot(void);
static uint64_t spin_lock_irqsave(spinlock_t *lock) {
    assert(lock == &g_udp_lock && !held);
    held = 1;
    locks++;
    return 0;
}
static void spin_unlock_irqrestore(spinlock_t *lock, uint64_t flags) {
    assert(lock == &g_udp_lock && held && !flags);
    held = 0;
    if (snapshot_hook && locks == 2) {
        snapshot_hook = 0;
        after_snapshot();
    }
}
static uint64_t timer_get_ticks(void) {
    assert(!held);
    return now;
}
static uint64_t random_u64(void) {
    assert(held);
    return ++nonce * 0x100000001ULL;
}
static int udp_start(void) {
    assert(!held);
    return start_error;
}
static int net_recvfrom_socket_meta(net_socket_t *s, void *data, size_t size,
                                    int flags, void *from, size_t *from_len,
                                    void *meta) {
    assert(!held && s == &socket && data == g_udp_rx &&
           size == sizeof(g_udp_rx));
    assert(flags == MSG_DONTWAIT && from &&
           *from_len == sizeof(net_sockaddr_in_t) && !meta);
    receives++;
    return -EAGAIN;
}
static void udp_receive(const uint8_t nh[6], const uint8_t *data,
                        uint32_t len) {
    (void)nh;
    (void)data;
    (void)len;
    assert(!"unexpected datagram in heartbeat fixture");
}
static void a20_clx_link_state_note(unsigned transport, const uint8_t *nh,
                                    unsigned len, unsigned state) {
    assert(!held && transport == A20_CLX_TRANSPORT_UDP && nh && len == 6);
    assert(state == A20_CLX_LINK_SUSPECT);
    suspects++;
}
static void a20_clx_link_event(unsigned transport, const uint8_t *nh,
                               unsigned len, int up) {
    assert(!held && transport == A20_CLX_TRANSPORT_UDP && nh && len == 6 &&
           !up);
    downs++;
}
#define kinfo(...) ((void)0)
static void udp_control(const clx_udp_peer_t *p, uint8_t type,
                        const uint8_t *echo, uint32_t txid) {
    assert(!held && p->used && !echo && !txid && sends < CLX_LIMIT_ROUTES);
    sent_type[sends] = type;
    sent_challenge[sends] = p->challenge;
    memcpy(sent_nh[sends++], p->nh, 6);
}

/* PRODUCTION_a20_clx_udp_peer_add */
/* PRODUCTION_a20_clx_udp_peer_del */
/* PRODUCTION_udp_poll */

static void address(unsigned id, uint8_t nh[6], uint8_t node[16]) {
    memset(node, 0, 16);
    node[12] = (uint8_t)(id >> 8);
    node[15] = (uint8_t)id;
    const uint8_t prefix[] = {10,          42,   (uint8_t)(id >> 8),
                              (uint8_t)id, 0xab, 0xf4};
    memcpy(nh, prefix, 6);
}
static void add(unsigned id) {
    uint8_t nh[6], node[16];
    address(id, nh, node);
    assert(a20_clx_udp_peer_add(node, nh, 6) == 0);
}
static void del(unsigned id) {
    uint8_t nh[6], node[16];
    address(id, nh, node);
    a20_clx_udp_peer_del(nh, 6);
}
static void check_bitmap(void) {
    for (unsigned i = 0; i < CLX_UDP_PEER_WORDS * 64; i++) {
        unsigned bit = (unsigned)((g_udp_active[i / 64] >> (i % 64)) & 1);
        assert(bit == (i < CLX_LIMIT_ROUTES && g_udp_peers[i].used));
    }
}
static unsigned count_peers(void) {
    unsigned count = 0;
    for (unsigned i = 0; i < CLX_LIMIT_ROUTES; i++)
        count += !!g_udp_peers[i].used;
    return count;
}
static void poll_at(uint64_t at, unsigned expected_sends) {
    now = at;
    locks = sends = 0;
    unsigned count = count_peers();
    udp_poll(NULL);
    if (locks != count + 2) {
        fprintf(stderr,
                "sparse/full poll lock visits=%u expected=%u capacity=%u "
                "active=%u\n",
                locks, count + 2, CLX_LIMIT_ROUTES, count);
        assert(locks == count + 2);
    }
    assert(!held && sends == expected_sends);
    check_bitmap();
}
static void reset(void) {
    assert(!held);
    memset(g_udp_peers, 0, sizeof(g_udp_peers));
    memset(g_udp_active, 0, sizeof(g_udp_active));
    g_udp_socket = &socket;
    now = 1;
    locks = sends = suspects = downs = receives = snapshot_hook = 0;
    start_error = 0;
}
static void after_snapshot(void) {
    /* Delete a captured entry and add a different, previously uncaptured slot.
     * The deleted entry must be skipped; the new slot is eligible next turn. */
    add(9);
    del(2);
}
static uint32_t prng = 0x7351bd29;
static unsigned next_random(void) {
    prng ^= prng << 13;
    prng ^= prng >> 17;
    prng ^= prng << 5;
    return prng;
}
int main(void) {
    reset();
    add(1);
    poll_at(1, 1); /* Negative control fails here on the legacy full scan. */
    assert(sent_type[0] == A20_CLX_TYPE_HELLO && sent_challenge[0]);
    poll_at(1000, 0);
    poll_at(1001, 1);
    assert(sent_type[0] == A20_CLX_TYPE_HELLO);
    /* Gateway aliases retain the directly attached peer's identity/session. */
    uint8_t nh[6], node[16];
    address(1, nh, node);
    node[0] = 99;
    g_udp_peers[0].remote_nonce = 456;
    uint32_t challenge = g_udp_peers[0].challenge;
    assert(a20_clx_udp_peer_add(node, nh, 6) == 0);
    assert(g_udp_peers[0].node.bytes[0] == 0 &&
           g_udp_peers[0].remote_nonce == 456);
    assert(g_udp_peers[0].challenge == challenge && count_peers() == 1);
    assert(a20_clx_udp_peer_add(NULL, nh, 6) == -A20_ERR_INVALID_ARGUMENT);
    assert(a20_clx_udp_peer_add(node, NULL, 6) == -A20_ERR_INVALID_ARGUMENT);
    assert(a20_clx_udp_peer_add(node, nh, 5) == -A20_ERR_INVALID_ARGUMENT);
    nh[4] = nh[5] = 0;
    assert(a20_clx_udp_peer_add(node, nh, 6) == -A20_ERR_INVALID_ARGUMENT);
    address(1, nh, node);
    nh[0] = 224;
    assert(a20_clx_udp_peer_add(node, nh, 6) == -A20_ERR_INVALID_ARGUMENT);
    memset(nh, 0, 4);
    nh[4] = 1;
    assert(a20_clx_udp_peer_add(node, nh, 6) == -A20_ERR_INVALID_ARGUMENT);
    address(2, nh, node);
    start_error = -A20_ERR_IO;
    assert(a20_clx_udp_peer_add(node, nh, 6) == start_error);
    start_error = 0;
    assert(count_peers() == 1);
    a20_clx_udp_peer_del(NULL, 6);
    a20_clx_udp_peer_del(nh, 5);
    /* Actual heartbeat state transitions at the 3 s / 6 s boundaries. */
    reset();
    add(1);
    g_udp_peers[0].state = A20_CLX_LINK_UP;
    g_udp_peers[0].last_rx = 1;
    poll_at(1, 1);
    assert(sent_type[0] == A20_CLX_TYPE_PING);
    poll_at(1001, 1);
    poll_at(2001, 1);
    poll_at(3000, 0);
    assert(!suspects && !downs && g_udp_peers[0].state == A20_CLX_LINK_UP);
    poll_at(3001, 1);
    assert(suspects == 1 && !downs &&
           g_udp_peers[0].state == A20_CLX_LINK_SUSPECT);
    assert(sent_type[0] == A20_CLX_TYPE_PING);
    poll_at(4001, 1);
    poll_at(5001, 1);
    poll_at(6000, 0);
    poll_at(6001, 1);
    assert(suspects == 1 && downs == 1 &&
           g_udp_peers[0].state == A20_CLX_LINK_DOWN);
    assert(sent_type[0] == A20_CLX_TYPE_HELLO);
    poll_at(7001, 1);
    assert(downs == 1);
    /* RX handshake recovery is a seam; the next real poll must resume PING. */
    g_udp_peers[0].state = A20_CLX_LINK_UP;
    g_udp_peers[0].last_rx = 8000;
    poll_at(8001, 1);
    assert(sent_type[0] == A20_CLX_TYPE_PING);
    g_udp_peers[0].state = A20_CLX_LINK_DOWN;
    g_udp_peers[0].challenge = 0;
    poll_at(9001, 1);
    assert(sent_challenge[0]);
    /* A deleted captured slot is harmless; a new slot waits until next poll. */
    reset();
    add(1);
    add(2);
    add(3);
    locks = 0;
    now = 1;
    snapshot_hook = 1;
    udp_poll(NULL);
    assert(!snapshot_hook && sends == 2 && count_peers() == 3);
    address(1, nh, node);
    assert(!memcmp(sent_nh[0], nh, 6));
    address(3, nh, node);
    assert(!memcmp(sent_nh[1], nh, 6));
    poll_at(2, 1);
    address(9, nh, node);
    assert(!memcmp(sent_nh[0], nh, 6));
    /* Fill the last slot, including non-word-aligned capacities, then reuse. */
    reset();
    for (unsigned i = 0; i < CLX_LIMIT_ROUTES; i++)
        add(i + 1);
    address(CLX_LIMIT_ROUTES + 1, nh, node);
    assert(a20_clx_udp_peer_add(node, nh, 6) == -A20_ERR_NO_SPACE);
    poll_at(1, CLX_LIMIT_ROUTES);
    del(CLX_LIMIT_ROUTES);
    assert(count_peers() == CLX_LIMIT_ROUTES - 1);
    add(CLX_LIMIT_ROUTES + 1);
    poll_at(2, 1);
    assert(!memcmp(sent_nh[0], nh, 6));
    for (unsigned i = 1; i < CLX_LIMIT_ROUTES; i++)
        del(i);
    poll_at(3, 0);
    del(CLX_LIMIT_ROUTES + 1);
    poll_at(4, 0);
    /* Deterministic mutation churn through the actual add/delete functions. */
    reset();
    unsigned char present[128] = {0};
    unsigned range = CLX_LIMIT_ROUTES < 128 ? CLX_LIMIT_ROUTES : 128;
    for (unsigned round = 0; round < 10000; round++) {
        unsigned id = next_random() % range;
        if (present[id])
            del(id + 1);
        else
            add(id + 1);
        present[id] ^= 1;
        unsigned count = 0;
        for (unsigned i = 0; i < range; i++)
            count += present[i];
        assert(count_peers() == count);
        poll_at((uint64_t)(round + 1) * 1000, count);
        for (unsigned i = 0; i < sends; i++) {
            unsigned id_sent = ((unsigned)sent_nh[i][2] << 8) | sent_nh[i][3];
            assert(id_sent && id_sent <= range && present[id_sent - 1]);
            assert(sent_type[i] == A20_CLX_TYPE_HELLO && sent_challenge[i]);
            for (unsigned j = 0; j < i; j++)
                assert(memcmp(sent_nh[j], sent_nh[i], 6));
        }
    }
    g_udp_socket = NULL;
    locks = 0;
    udp_poll(NULL);
    assert(locks == 1 && !held);
    printf("UDP peers: PASS capacity=%u, sparse/full budgets, heartbeat "
           "boundaries, 10000 mutations\n",
           CLX_LIMIT_ROUTES);
    return 0;
}
