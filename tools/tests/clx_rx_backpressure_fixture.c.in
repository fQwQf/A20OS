/* Execute the production RX pop and poll-owner backpressure handshake. */
#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#define CLX_RX_RING 64u
#define CLX_RX_POLL_HIGH_WATER (CLX_RX_RING / 2)
#define MS_TO_TICKS(ms) (ms)
#define PROC_WAIT_UNINTERRUPTIBLE 0
#define PROC_WAKE_EVENT 1
#define A20_CLX_LINK_ADDR_MAX 16u
typedef int spinlock_t;
typedef struct {
    void *task;
    uint64_t seq;
} proc_wait_token_t;
typedef struct {
    int unused;
} wait_queue_t;
typedef struct {
    int linked;
    proc_wait_token_t token;
} wait_queue_entry_t;
typedef struct {
    uint8_t *frame;
    uint32_t len, transport_id;
    uint8_t nh_src[A20_CLX_LINK_ADDR_MAX];
    uint32_t nh_len;
} clx_rx_item_t;
#define A20_CLX_MAX_TRANSPORTS 2u
#define A20_CLX_TFL_POLLING 4u
typedef struct {
    unsigned flags;
    void (*poll)(void *);
    void *ctx;
} a20_clx_transport_t;
static a20_clx_transport_t g_clx_transports[A20_CLX_MAX_TRANSPORTS];
static unsigned g_clx_transport_count;
static spinlock_t g_clx_lock, g_clx_rx_lock;
static uint64_t ticks = 100;
static unsigned poll_rounds, poll_calls[2];
static wait_queue_t g_clx_rx_waiters;
static clx_rx_item_t g_clx_rx_ring[CLX_RX_RING];
static uint32_t g_clx_rx_head, g_clx_rx_tail, g_clx_rx_bytes;
static int g_clx_core_ready;
static wait_queue_entry_t *linked_entry;
enum { IDLE, BEFORE_PREPARE, EARLY, LATE, PREPARE_FAIL, LINK_FAIL };
static unsigned mode, held, injected, woken, wakes, prepares, commits, cancels;
static unsigned finishes, sleeps;
static int clx_rx_pop(clx_rx_item_t *out);
static unsigned queued(void) {
    return (g_clx_rx_head + CLX_RX_RING - g_clx_rx_tail) % CLX_RX_RING;
}
static void drain(void) {
    assert(!held);
    clx_rx_item_t item;
    while (queued() >= CLX_RX_POLL_HIGH_WATER)
        assert(clx_rx_pop(&item));
}
static uint64_t timer_get_ticks(void) {
    return ticks;
}
static uint64_t spin_lock_irqsave(spinlock_t *lock) {
    assert((lock == &g_clx_rx_lock || lock == &g_clx_lock) && !held);
    held = lock == &g_clx_rx_lock ? 1 : 2;
    return 0;
}
static void spin_unlock_irqrestore(spinlock_t *lock, uint64_t flags) {
    assert((lock == &g_clx_rx_lock ? held == 1 : held == 2) && !flags);
    held = 0;
    if (mode == EARLY && linked_entry && !injected) {
        injected = 1;
        drain();
    }
}
static unsigned wait_queue_wake_one(wait_queue_t *queue, uintptr_t key,
                                    int reason) {
    assert(!held && queue == &g_clx_rx_waiters && key == 2 &&
           reason == PROC_WAKE_EVENT);
    assert(queued() == CLX_RX_POLL_HIGH_WATER - 1);
    wakes++;
    if (linked_entry) {
        assert(linked_entry->linked && linked_entry->token.seq == 42);
        linked_entry->linked = 0;
        linked_entry = NULL;
        woken++;
        return 1;
    }
    return 0;
}
static proc_wait_token_t proc_park_prepare(int kind, uint64_t deadline) {
    assert(!held && kind == PROC_WAIT_UNINTERRUPTIBLE && deadline == ticks + 1);
    prepares++;
    if (mode == BEFORE_PREPARE)
        drain();
    return (proc_wait_token_t){mode == PREPARE_FAIL ? NULL : &mode, 42};
}
static int wait_queue_link(wait_queue_t *queue, wait_queue_entry_t *entry,
                           proc_wait_token_t token, uintptr_t key) {
    assert(held && queue == &g_clx_rx_waiters && key == 2 && token.seq == 42);
    assert(!linked_entry && queued() >= CLX_RX_POLL_HIGH_WATER);
    if (mode == LINK_FAIL)
        return 0;
    entry->linked = 1;
    entry->token = token;
    linked_entry = entry;
    return 1;
}
static int proc_park_commit(proc_wait_token_t token) {
    assert(!held && token.seq == 42);
    commits++;
    if (mode == LATE) {
        assert(linked_entry && !woken);
        drain();
    }
    assert(mode == IDLE || woken == 1);
    return 0;
}
static int proc_park_cancel(proc_wait_token_t token) {
    assert(!held && token.seq == 42 && !linked_entry);
    cancels++;
    return 0;
}
static void wait_queue_unlink(wait_queue_t *queue, wait_queue_entry_t *entry) {
    assert(!held && queue == &g_clx_rx_waiters);
    if (linked_entry) {
        assert(linked_entry == entry);
        linked_entry = NULL;
        entry->linked = 0;
    }
}
static void proc_park_finish(proc_wait_token_t token) {
    assert(!held && token.seq == 42 && !linked_entry);
    finishes++;
}
static void proc_sleep_until(uint64_t deadline) {
    assert(!held && deadline == ticks + 1);
    sleeps++;
}
static void *proc_current(void) {
    return &mode;
}
static void proc_set_name(void *task, const char *name) {
    assert(task == &mode && !strcmp(name, "clx-poll"));
}
static void a20_clx_udp_wait(uint64_t deadline) {
    assert(!held && deadline == ticks + 1);
    ticks = deadline;
    if (++poll_rounds == 250)
        g_clx_core_ready = 3;
}
static void poll_adapter(void *ctx) {
    assert(!held);
    unsigned id = (uintptr_t)ctx;
    assert(id < 2);
    poll_calls[id]++;
}
/* PRODUCTION_clx_rx_pop */
/* PRODUCTION_clx_rx_poll_ready */
/* PRODUCTION_clx_poll_thread */
static void reset(unsigned count, unsigned tail) {
    assert(count < CLX_RX_RING && tail < CLX_RX_RING);
    memset(g_clx_rx_ring, 0, sizeof(g_clx_rx_ring));
    for (unsigned i = 0; i < CLX_RX_RING; i++)
        g_clx_rx_ring[i].len = 1;
    g_clx_rx_tail = tail;
    g_clx_rx_head = (tail + count) % CLX_RX_RING;
    g_clx_rx_bytes = count;
    g_clx_core_ready = 2;
    mode = held = injected = woken = wakes = prepares = commits = cancels = 0;
    finishes = sleeps = 0;
    linked_entry = NULL;
    ticks = 100;
}
int main(void) {
    for (unsigned i = 0; i < 250000; i++) {
        reset(CLX_RX_POLL_HIGH_WATER + i % 32, i % 64);
        mode = i % 6;
        int expected = mode == BEFORE_PREPARE || mode == EARLY || mode == LATE;
        assert(clx_rx_poll_ready() == expected);
        assert(!held && !linked_entry && prepares == 1);
        assert(finishes == (mode != PREPARE_FAIL));
        assert(sleeps == (mode == PREPARE_FAIL));
        assert(commits == (mode == IDLE || mode == EARLY || mode == LATE));
        assert(cancels == (mode == BEFORE_PREPARE || mode == LINK_FAIL));
        assert(woken == (mode == EARLY || mode == LATE));
        assert(wakes == (unsigned)expected && g_clx_rx_bytes == queued());
        reset(i % 32, i % 64);
        assert(clx_rx_poll_ready() && !prepares && !commits && !cancels);
    }
    reset(63, 60);
    g_clx_core_ready = 3;
    assert(!clx_rx_poll_ready() && cancels == 1 && !commits && finishes == 1);
    for (unsigned full = 0; full < 2; full++) {
        reset(full ? 63 : 0, 0);
        poll_rounds = poll_calls[0] = poll_calls[1] = 0;
        g_clx_transport_count = 2;
        for (unsigned id = 0; id < 2; id++)
            g_clx_transports[id] = (a20_clx_transport_t){
                A20_CLX_TFL_POLLING, poll_adapter, (void *)(uintptr_t)id};
        clx_poll_thread();
        /* Congestion cannot indefinitely suppress adapter control work. */
        assert(poll_calls[0] == (full ? 3u : 250u));
        assert(poll_calls[1] == poll_calls[0] && poll_rounds == 250);
        assert(!held && !linked_entry);
    }
    puts("clx_rx_backpressure: 250K full/wrapped ring, early/late space wakes, "
         "timeout and park failures PASS");
    return 0;
}
