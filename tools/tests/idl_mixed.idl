// Fixture for tools/tests/test_a20_idl_mixed.c.
//
// Two messages, chosen so the two cases are both exercised:
//
//   MIXED  {u8,u16,u32,u64} = 15 wire bytes at offsets 0/1/3/7.  A host
//          struct of those fields is 16 bytes with the u32 at offset 4, so the
//          struct is NOT the wire layout.  This is the case that caught the
//          u8 emitter bug (it wrote `buf + OFF = src->f;`, which does not
//          compile) and the case that would break if the header ever grew an
//          unconditional layout assert.  Only a compiled test can tell.
//
//   PACKED {u16,u16,u32,u64} = 16 wire bytes at offsets 0/2/4/8.  The host
//          struct is exactly those bytes, which is the shape every interface
//          version 1 message has and the reason the generator can emit layout
//          asserts for them.
//
// A version number is declared only because the grammar requires one; the
// generated header is a throwaway here, not the shipped
// user/svc/a20_services_idl.h.
interface a20idl_mixed version 1 {
  message MIXED {
    u8 tag;
    u16 id;
    u32 count;
    u64 stamp;
  }
  message PACKED {
    u16 id;
    u16 kind;
    u32 count;
    u64 stamp;
  }
  message SIGNED {
    i32 minimum32;
    i64 minimum64;
  }
}
