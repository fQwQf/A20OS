/* Actual UDP readiness wait; deterministic scheduler/socket lifetime seams. */
#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#define PROC_WAIT_UNINTERRUPTIBLE 0
typedef int spinlock_t;
typedef struct {
    void *task;
    uint64_t seq;
} proc_wait_token_t;
typedef struct {
    unsigned unused;
} wait_queue_t;
typedef struct {
    int linked;
    proc_wait_token_t token;
} wait_queue_entry_t;
typedef struct {
    int refs, closed, shut_rd, bh_pending;
    void *rx_head;
    wait_queue_t read_waitq;
} net_socket_t;
static spinlock_t g_udp_lock;
static net_socket_t socket, *g_udp_socket;
static wait_queue_entry_t *linked_entry;
enum {
    IDLE,
    BEFORE_PREPARE,
    EARLY,
    LATE,
    PREPARE_FAIL,
    LINK_FAIL,
    QUEUED,
    PENDING_BH,
    CLOSED,
    SHUT_RD,
    NO_SOCKET
};
static unsigned mode, held, woken, prepares, commits, cancels, finishes, sleeps;
static uint64_t spin_lock_irqsave(spinlock_t *lock) {
    assert(lock == &g_udp_lock && !held);
    held = 1;
    return 0;
}
static void spin_unlock_irqrestore(spinlock_t *lock, uint64_t flags) {
    assert(lock == &g_udp_lock && held == 1 && !flags);
    held = 0;
}
static net_socket_t *net_socket_ref(net_socket_t *s) {
    assert(held == 1);
    if (s) {
        assert(s == &socket && s->refs == 7);
        s->refs++;
    }
    return s;
}
static void net_socket_free(net_socket_t *s) {
    assert(!held && s == &socket && s->refs == 8 && !linked_entry);
    s->refs--;
}
static proc_wait_token_t proc_park_prepare(int wait_mode, uint64_t deadline) {
    assert(!held && wait_mode == PROC_WAIT_UNINTERRUPTIBLE && deadline == 110);
    prepares++;
    if (mode == BEFORE_PREPARE)
        socket.rx_head = &socket;
    return (proc_wait_token_t){mode == PREPARE_FAIL ? NULL : &socket, 42};
}
static uint64_t net_sock_lock(net_socket_t *s) {
    assert(!held && s == &socket && s->refs == 8);
    held = 2;
    return 0;
}
static void ready(void) {
    assert(!held && linked_entry && linked_entry->linked &&
           linked_entry->token.seq == 42);
    socket.rx_head = &socket;
    linked_entry->linked = 0;
    linked_entry = NULL;
    woken++;
}
static void net_sock_unlock(net_socket_t *s, uint64_t flags) {
    assert(s == &socket && held == 2 && !flags);
    held = 0;
    if (mode == EARLY && linked_entry)
        ready();
}
static int wait_queue_link(wait_queue_t *queue, wait_queue_entry_t *entry,
                           proc_wait_token_t token, uintptr_t key) {
    assert(held == 2 && queue == &socket.read_waitq && !linked_entry &&
           token.seq == 42 && !key);
    if (mode == LINK_FAIL)
        return 0;
    entry->linked = 1;
    entry->token = token;
    linked_entry = entry;
    return 1;
}
static int proc_park_commit(proc_wait_token_t token) {
    assert(!held && token.task == &socket && token.seq == 42);
    commits++;
    if (mode == LATE)
        ready();
    assert(woken == (mode == EARLY || mode == LATE));
    return woken ? 1 : 2;
}
static int proc_park_cancel(proc_wait_token_t token) {
    assert(!held && token.task == &socket && token.seq == 42 && !commits);
    cancels++;
    return 0;
}
static void wait_queue_unlink(wait_queue_t *queue, wait_queue_entry_t *entry) {
    assert(!held && queue == &socket.read_waitq);
    if (linked_entry == entry)
        linked_entry = NULL;
    entry->linked = 0;
}
static void proc_park_finish(proc_wait_token_t token) {
    assert(!held && token.task == &socket && token.seq == 42 && !linked_entry);
    finishes++;
}
static void proc_sleep_until(uint64_t deadline) {
    assert(!held && deadline == 110 && socket.refs == 7);
    sleeps++;
}
/* PRODUCTION_a20_clx_udp_wait */
int main(void) {
    for (unsigned iteration = 0; iteration < 250000; iteration++) {
        mode = iteration % 11;
        memset(&socket, 0, sizeof(socket));
        socket.refs = 7;
        g_udp_socket = mode == NO_SOCKET ? NULL : &socket;
        socket.closed = mode == CLOSED;
        socket.shut_rd = mode == SHUT_RD;
        socket.rx_head = mode == QUEUED ? &socket : NULL;
        socket.bh_pending = mode == PENDING_BH;
        woken = prepares = commits = cancels = finishes = sleeps = 0;
        a20_clx_udp_wait(110);
        assert(!held && !linked_entry && socket.refs == 7);
        assert(prepares == (mode != NO_SOCKET));
        assert(commits == (mode == IDLE || mode == EARLY || mode == LATE));
        assert(woken == (mode == EARLY || mode == LATE));
        assert(finishes == (mode != NO_SOCKET && mode != PREPARE_FAIL));
        assert(finishes == commits + cancels);
        assert(sleeps == (mode == NO_SOCKET || mode == PREPARE_FAIL ||
                          mode == CLOSED || mode == SHUT_RD));
    }
    puts("clx_udp_wakeup: 250K readiness races, pending BH, timeout, failed "
         "prepare/link and balanced socket refs PASS");
    return 0;
}
