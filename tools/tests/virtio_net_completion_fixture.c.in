/* Host device fixture template. The checker splices the real completion body
 * here; this file supplies only queue storage, DMA stubs and assertions. */
#include <assert.h>
#include <stdint.h>
#include <stdio.h>
#include <string.h>

#define VIRTIO_NET_QUEUE_SIZE 256u
typedef struct {
    uint32_t id, len;
} virtq_used_elem_t;
typedef struct {
    uint16_t flags, idx;
    virtq_used_elem_t ring[VIRTIO_NET_QUEUE_SIZE];
} virtio_net_used_t;
typedef struct {
    virtio_net_used_t *used;
    /* Kept in the fixture to demonstrate that the old remapping fails. */
    uint16_t *slot_of_avail;
    uint16_t last_used;
} virtio_net_queue_t;
typedef struct {
    virtio_net_queue_t txq;
    unsigned qsize;
    uint8_t tx_busy[VIRTIO_NET_QUEUE_SIZE];
} virtio_net_inst_t;
static virtio_net_used_t used;
static uint16_t aliases[VIRTIO_NET_QUEUE_SIZE];

static void arch_dma_sync_for_cpu(void *ptr, unsigned bytes) {
    (void)ptr;
    (void)bytes;
}
static virtio_net_used_t *queue_used(virtio_net_inst_t *net,
                                     virtio_net_queue_t *q) {
    (void)net;
    return q->used;
}

/* PRODUCTION_COMPLETION */

static void complete(virtio_net_inst_t *net, uint32_t id) {
    used.ring[used.idx % net->qsize].id = id;
    used.idx++;
    virtio_net_complete_tx_locked(net);
    assert(net->txq.last_used == used.idx);
}

int main(void) {
    virtio_net_inst_t net = {.txq = {.used = &used, .slot_of_avail = aliases},
                             .qsize = VIRTIO_NET_QUEUE_SIZE};
    memset(aliases, 0, sizeof(aliases));
    net.tx_busy[0] = net.tx_busy[3] = 1;
    aliases[3] = 7;
    net.tx_busy[7] = 1;
    complete(&net, 3);
    assert(!net.tx_busy[3] && net.tx_busy[0] && net.tx_busy[7]);

    /* Out-of-order completion must free only the named descriptors. */
    net.tx_busy[1] = net.tx_busy[5] = net.tx_busy[8] = 1;
    complete(&net, 7);
    complete(&net, 1);
    complete(&net, 5);
    assert(!net.tx_busy[7] && !net.tx_busy[1] && !net.tx_busy[5]);
    assert(net.tx_busy[8] && net.tx_busy[0]);

    /* Invalid device IDs must neither alias via modulo nor truncate to u16. */
    complete(&net, 256);
    complete(&net, 65536);
    complete(&net, UINT32_MAX);
    assert(net.tx_busy[0] && net.tx_busy[8]);
    memset(net.tx_busy, 0, sizeof(net.tx_busy));
    used.idx = net.txq.last_used = 65534;
    for (unsigned i = 0; i < 300000; i++) {
        unsigned slot = (i * 73 + 19) % net.qsize;
        net.tx_busy[slot] = 1;
        complete(&net, slot);
        assert(!net.tx_busy[slot]);
    }
    for (unsigned i = 0; i < net.qsize; i++)
        assert(!net.tx_busy[i]);
    puts("virtio-net completion: descriptor IDs, out-of-order, invalid IDs and "
         "300000 wraparound completions PASS");
}
