def _report(inst, result, log) -> int:
    """Print the verdict and keep the transcript either way."""
    write_console_log(log, result.transcript)
    if result.ok:
        print(f"{inst.name}: console OK ({result.stage}); transcript in {log}")
        return EXIT_OK
    print(f"{inst.name}: console FAIL at {result.stage}; missing {list(result.missing)}; "
          f"transcript in {log}", file=sys.stderr)
    print(result.transcript.tail(60), file=sys.stderr)
    return EXIT_FAIL


def cmd_console(args: argparse.Namespace) -> int:
    """Attach to a board's serial console and run the declared on-board check."""
    inst = _load(args.instance)
    if not section_is_set(inst.target):
        raise A20Error(f"{inst.source}: a20 console needs a [target] section",
                       hint="a [target] section declares serial, console_check, "
                            "commands and expect")
    if getattr(args, "serial", None):
        inst = replace(inst, target=replace(inst.target, serial=args.serial))
    if inst.board == "esp32-c3" and not args.no_reset and not inst.target.reset:
        inst = replace(inst, target=replace(inst.target, reset=
            "python3 tools/esp32c3.py reset --port " + shlex.quote(inst.target.serial or "auto")))
    if args.no_reset:
        inst = replace(inst, target=replace(inst.target, reset=None))
    auto_handoff = getattr(args, "auto_handoff", False)
    if auto_handoff and getattr(args, "interactive", False):
        raise A20Error("--auto-handoff and --interactive cannot be combined")
    if auto_handoff and inst.board not in {"pine-a64", "licheerv-nano", "ls2k0300",
                                           "lichee-pi-zero", "quartz64-zero", "ox64"}:
        raise A20Error(f"automatic U-Boot handoff is unavailable for {inst.board}")
    if auto_handoff and not inst.handoff.commands:
        raise A20Error("automatic handoff requires the instance's [handoff].commands")
    if args.dry_run:
        # Previously ignored: `a20 console --dry-run` opened the real serial
        # port and injected target.commands at a live board, which is the exact
        # opposite of what the flag says.
        t = inst.target
        print(f"would open {t.serial} at {t.baud or 115200} baud")
        if t.reset:
            print(f"would reset: {t.reset}")
        if t.console_check:
            print(f"would wait for prompt: {t.console_check!r} "
                  f"(timeout {t.boot_timeout or '120s'})")
        if getattr(args, "interactive", False):
            print("would forward operator input on this same serial connection (Ctrl-] aborts)")
        if auto_handoff:
            print("would stop U-Boot autoboot, verify payloads, load the kernel and check its boot log")
        for cmd in t.commands or ():
            print(f"would send: {cmd}")
        for want in t.expect or ():
            print(f"would require: {want!r}")
        print(f"transcript would go to {console_log_path(inst)}")
        return EXIT_OK
    log = console_log_path(inst)
    try:
        transport = open_transport(inst)
    except OSError as e:
        raise BoardUnreachable(
            f"cannot open console {inst.target.serial!r}: {e}",
            hint="is the board attached, and is this user in the dialout group?") from None
    try:
        if getattr(args, "interactive", False):
            transport = InteractiveTransport(transport, sys.stdin.fileno())
            print("Interactive boot console: enter bootloader commands here; Ctrl-] aborts. "
                  "Boot checks still use target.boot_timeout.", flush=True)
    except OSError as e:
        transport.close()
        raise BoardUnreachable(
            f"cannot enable operator input: {e}") from None
    try:
        if auto_handoff:
            bundle = REPO_ROOT / "build" / inst.board / "handoff"
            if inst.board == "ls2k0300":
                from ls2k0300_handoff import run_handoff
                try:
                    result = run_handoff(transport, inst, bundle=bundle,
                                         server_ip=args.server_ip, board_ip=args.board_ip,
                                         transfer=args.transfer, on_output=_echo)
                finally:
                    transport.close()
            else:
                from a20_handoff import run_image_handoff
                result = run_image_handoff(transport, inst, bundle,
                                          server_ip=args.server_ip, board_ip=args.board_ip,
                                          on_output=_echo)
        else:
            result = run_console_session(transport, inst, on_output=_echo)
    except (ConsoleError, KeyboardInterrupt) as e:
        transport.close()
        if isinstance(transport, InteractiveTransport):
            write_console_log(log, transport.transcript)
        raise BoardUnreachable(str(e)) from None
    return _report(inst, result, log)


def cmd_deploy(args: argparse.Namespace) -> int:
    """Build, program the board, write boot media, then verify it over the console."""
    inst = _load(args.instance)
    stage_mount = getattr(args, "stage_mount", None)
    if stage_mount and inst.board != "ls2k0300":
        raise A20Error("--stage-mount is available only for the LS2K0300 FAT handoff bundle")
    if inst.board == "m0sense-bl702":
        return _deploy_m0sense(inst, args)
    if getattr(args, "media_device", None):
        inst = replace(inst, target=replace(inst.target, media_device=args.media_device))
    if not section_is_set(inst.target):
        raise A20Error(f"{inst.source}: a20 deploy needs a [target] section")
    if inst.target.boot_media and not inst.target.media_device:
        raise A20Error(f"{inst.source}: target.boot_media is declared but "
                       "target.media_device is not, so there is nowhere to write it")
    if not (inst.target.boot_media or inst.handoff.commands or inst.flash.tool):
        raise A20Error(f"{inst.source}: deploy needs boot media, handoff commands or a flash backend")
    no_build = getattr(args, "no_build", False)
    if getattr(args, "auto_handoff", False) and getattr(args, "no_console", False):
        raise A20Error("--auto-handoff and --no-console cannot be combined")
    if getattr(args, "interactive", False) and getattr(args, "no_console", False):
        raise A20Error("--interactive and --no-console cannot be combined")
    if no_build and inst.flash.tool and not args.no_flash:
        raise A20Error("deploy --no-build with a flash backend requires --no-flash")
    if no_build:
        print(f"{inst.name}: using existing deployment artifacts (--no-build)")
    elif not args.no_flash and section_is_set(inst.flash):
        flash_args = list(args.make_args)
        if getattr(args, "serial", None):
            variable = {"esp32-c3": "ESPTOOL_PORT", "hi3861": "HI3861_PORT"}.get(inst.board)
            if variable:
                flash_args.append(f"{variable}={args.serial}")
        run_flash(inst, _flash_backends(), flash_args, args.dry_run)
    elif section_is_set(inst.flash):
        pass
    elif inst.package.kind and (inst.handoff or inst.target.boot_media):
        # Whatever this instance's artifact is -- a rescue ISO, a bootable disk,
        # a boot bundle -- it has to be assembled before anything can consume it.
        # Both consumers need it: a handoff board loads the bundle, and a board
        # with boot_media writes it to a device.  Keying this on handoff alone
        # left every board that deploys by writing media building a kernel into
        # the build directory and then failing at target-write-media, because the
        # image it named in boot_media had never been produced.
        run_package(inst, list(args.make_args), args.dry_run)
    elif not args.dry_run:
        build_instance(inst, list(args.make_args), args.dry_run)
    if stage_mount:
        if args.dry_run:
            print(f"would verify and stage kernel.elf to {stage_mount}/a20/kernel.elf")
        else:
            from ls2k0300_handoff import stage_bundle
            try:
                result = stage_bundle(REPO_ROOT / "build/ls2k0300/handoff", Path(stage_mount))
            except (OSError, ValueError) as exc:
                raise A20Error(f"LS2K0300 FAT staging: {exc}") from None
            print(f"LS2K0300: staged {result['destination']} (sha256 {result['sha256']})")
    if inst.target.boot_media:
        if args.dry_run:
            print(f"would write {' '.join(inst.target.boot_media)} "
                  f"to {inst.target.media_device}")
        else:
            # exec_make raises on failure, so there is no status to check. The
            # `rc = ...; if rc != 0` that used to be here bound None, compared
            # unequal to 0, and returned None -- an accidental exit code 0 that
            # hid the fact this goal was the one call site dropping make args.
            exec_make(inst, "target-write-media", list(args.make_args), args.dry_run)
    if inst.handoff and inst.handoff.commands:
        _handoff_report(inst, args)
    if getattr(args, "no_console", False):
        print(f"{inst.name}: deployment preparation finished; boot the hardware, "
              "with a20 console already attached to capture and validate its boot")
        return EXIT_OK
    return cmd_console(args)


def _deploy_m0sense(inst: Instance, args: argparse.Namespace) -> int:
    from m0sense_deploy_uf2 import deploy
    if getattr(args, "auto_handoff", False):
        raise A20Error("M0Sense uses its USB UF2 bootloader; --auto-handoff is for U-Boot")
    if not getattr(args, "no_build", False):
        run_package(inst, list(args.make_args), args.dry_run)
    folder = REPO_ROOT / "build/m0sense-bl702/handoff"
    transport = None
    if args.dry_run:
        print(f"would verify probe.uf2 and copy it to the identified M0Sense UF2 volume "
              f"({getattr(args, 'uf2_mount', None) or 'auto-detected'})")
    else:
        try:
            if not getattr(args, "no_console", False):
                if getattr(args, "serial", None):
                    inst = replace(inst, target=replace(inst.target, serial=args.serial))
                # The factory USB loader resets immediately after the final
                # UF2 block. Open UART first so its one-shot boot markers are
                # queued before the copy completes.
                transport = open_transport(inst)
            deploy(folder / "probe.uf2", folder / "probe.json",
                   Path(args.uf2_mount) if args.uf2_mount else None, False)
        except (OSError, ValueError, RuntimeError) as exc:
            if transport is not None:
                transport.close()
            raise A20Error(f"M0Sense UF2 deployment: {exc}") from None
        except BaseException:
            if transport is not None:
                transport.close()
            raise
    if getattr(args, "no_console", False):
        print("M0Sense: UF2 transfer prepared/completed; check the documented blue-LED heartbeat. "
              "Use an external 3.3 V UART for serial acceptance.")
        return EXIT_OK
    if args.dry_run:
        print("would open the external UART before uploading UF2, then verify startup markers")
        return cmd_console(args)
    try:
        result = run_console_session(transport, replace(inst, target=replace(inst.target, reset=None)),
                                     on_output=_echo)
        return _report(inst, result, console_log_path(inst))
    finally:
        transport.close()


def _handoff_report(inst, args: argparse.Namespace) -> None:
    """Explain default card boot, automatic RAM handoff or manual recovery."""
    h = inst.handoff
    if getattr(args, "auto_handoff", False):
        print(f"\nAutomatic RAM handoff for {inst.board}; bootloader replies and payload checks are required.")
    elif inst.package.kind == "board-sdcard":
        print(f"\n{inst.board}: the prepared SD card auto-boots. The following commands are manual recovery only.")
    else:
        print(f"\n{h.method or 'handoff'} for {inst.board}: transfer the bundle, then run these at the boot chain.\n")
    if h.server:
        print(f"  server {h.server}")
    recipe = REPO_ROOT / "build" / inst.board / "handoff" / "uboot.cmd"
    lines = (recipe.read_text().splitlines()
             if not args.dry_run and recipe.is_file() else h.commands)
    if args.dry_run and inst.board not in {"ls2k0300", "m0sense-bl702"}:
        print("  (the packaged uboot.cmd supplies the checked payload and kernel addresses)")
    for line in lines:
        print(f"  {line}")
    if h.note:
        print(f"\n{h.note}")
    print()


def _port_note(inst) -> str:
    """One line describing what host ports this instance will claim.

    Printed before launch because with the default no longer claiming 5555, the
    port a guest is reachable on is a property of the instance, and the operator
    needs to see it rather than infer it.  Covers [net].backend too (e.g. the
    cluster demo's UDP tunnel), not just [net].hostfwd.
    """
    from a20_resource import format_net_port, instance_net_ports
    ports = instance_net_ports(inst)
    if not ports:
        if inst.net.backend:
            return f"{inst.name}: backend {inst.net.backend} claims no fixed host port"
        if inst.net.hostfwd:
            return f"{inst.name}: host forwarding {', '.join(inst.net.hostfwd)} (ephemeral ports)"
        return f"{inst.name}: no host port forwarding (nothing to connect to)"
    return f"{inst.name}: host ports {', '.join(format_net_port(p) for p in ports)}"


def cmd_ports(args: argparse.Namespace) -> int:
    """Show which host ports instances claim, and whether they are free now.

    Two instances declaring the same port is a legitimate choice -- you may only
    ever run one of them at a time -- so this reports rather than fails.  It
    exists because the failure mode otherwise shows up as QEMU refusing to bind
    several minutes into a build.
    """
    from a20_resource import busy_ports, instance_net_ports
    names = list(getattr(args, "instance", None) or ())
    paths = [Path(n) for n in names] if names else sorted(INSTANCES_DIR.glob("*.toml"))
    claimed: dict[tuple[str, int, str], list[str]] = {}
    rows: list[tuple[str, str, str]] = []
    bad = 0
    for path in paths:
        try:
            inst = _load(str(path))
        except A20Error as e:
            bad += 1
            rows.append((path.stem, "-", f"invalid manifest: {e}"))
            continue
        want = instance_net_ports(inst)
        if not want:
            state = "ephemeral" if inst.net.hostfwd or inst.net.backend else "none"
            rows.append((inst.name, state, "declares no fixed host port"))
            continue
        busy = set(busy_ports(want))
        for addr, port, proto in want:
            # tcp and udp forwards of one instance share a port number; list the
            # instance once so the collision note reads as "who", not "how many".
            holders = claimed.setdefault((addr, port, proto), [])
            if inst.name not in holders:
                holders.append(inst.name)
            where = f"{addr}:{port}" if proto == "tcp" else f"{addr}:{port}/udp"
            rows.append((inst.name, where,
                         "IN USE" if (addr, port, proto) in busy else "free"))
    width = max((len(r[0]) for r in rows), default=10)
    for name, where, state in rows:
        print(f"{name:<{width}}  {where:<22} {state}")
    clashes = {k: v for k, v in claimed.items() if len(v) > 1}
    if clashes:
        print()
        for (addr, port, proto), names in sorted(clashes.items()):
            suffix = "" if proto == "tcp" else "/udp"
            print(f"note: {addr}:{port}{suffix} is claimed by {', '.join(sorted(names))}"
                  " -- fine if you never run them together, otherwise give one an ephemeral"
                  " port (hostfwd = [\"tcp::0-<guestport>\"])", file=sys.stderr)
    if bad:
        print(f"ports: {bad} instance(s) could not be read", file=sys.stderr)
        return EXIT_FAIL
    return EXIT_OK

def cmd_ledger(args: argparse.Namespace) -> int:
    """Report what an instance actually produced: sizes, hashes, revision."""
    manifest = collect_manifest(_load(args.instance))
    if args.format == "json":
        text = render_json(manifest)
    elif args.format == "markdown":
        text = render_markdown(manifest)
    else:
        text = render_table(manifest)
    if args.out:
        write_ledger(manifest, Path(args.out), args.format)
        print(f"{manifest.instance}: ledger written to {args.out}")
    else:
        print(text)
    return 0 if manifest.artifacts else 1


