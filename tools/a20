def cmd_boards(args: argparse.Namespace) -> int:
    """List the boards in the tree, not the instances that mention them.

    A board is a directory under kernel/platform/ holding a board.c that defines
    current_board.  There was no way to ask this question before: `a20 list`
    shows instances, so a board without an instance -- which is every board
    until somebody writes one -- was invisible, and picking a porting target
    means starting from that list.
    """
    plat = REPO_ROOT / "kernel" / "platform"
    dirs = sorted(d for d in plat.iterdir() if d.is_dir()) if plat.is_dir() else []
    if args.arch:
        dirs = [d for d in dirs if _board_arch(d) == args.arch]
    if not dirs:
        print(f"boards: none found{(' for arch=' + args.arch) if args.arch else ''}",
              file=sys.stderr)
        return EXIT_OK
    print(f"{'board':<24} {'arch':<12} {'smp':<5} {'ldscript':<9} description")
    for d in dirs:
        src = d / "board.c"
        if not src.is_file():
            print(f"{d.name:<24} {'-':<12} {'-':<5} {'-':<9} "
                  f"platform files only -- no board.c, not a buildable board")
            continue
        text = src.read_text(errors="replace")
        arch = _board_arch(d) or "?"
        smp = "yes" if re.search(r"\.smp\s*=\s*&", text) else "no"
        lds = "yes" if (d / "ldscript.ld").is_file() else "no"
        print(f"{d.name:<24} {arch:<12} {smp:<5} {lds:<9} {_board_summary(text)}")
    print(f"\n{len(dirs)} board(s).  Board facts live in "
          f"kernel/platform/<board>/board.c and its <board>_platform.h;\n"
          f"a new arch additionally needs a CONFIG_BOARD_* block in "
          f"kernel/arch/<arch>/include/platform.h.")
    return EXIT_OK


def _board_arch(d: Path) -> str | None:
    """Which architecture claims this board.

    Read from the arch headers rather than a table: a board belongs to an
    architecture when kernel/arch/<arch>/include/platform.h has a block for its
    CONFIG_BOARD_ token, and to nothing when none does.  That is the same fact
    the build uses, so the answer cannot drift from what compiles.  Instances
    are the fallback for boards that predate the override mechanism and are
    still guarded only by their own CONFIG_<ARCH>.
    """
    src = d / "board.c"
    if not src.is_file():
        return None
    m = re.search(r"CONFIG_BOARD_([A-Z0-9_]+)", src.read_text(errors="replace"))
    if m:
        token = "CONFIG_BOARD_" + m.group(1)
        arch_root = REPO_ROOT / "kernel" / "arch"
        if arch_root.is_dir():
            for arch_dir in sorted(p for p in arch_root.iterdir() if p.is_dir()):
                plat = arch_dir / "include" / "platform.h"
                if plat.is_file() and token in plat.read_text(errors="replace"):
                    return arch_dir.name
    # Boards that predate the CONFIG_BOARD_ override are guarded only by their
    # own CONFIG_<ARCH>, so the instances are the only place the pairing lives.
    for toml in sorted(INSTANCES_DIR.glob("*.toml")):
        try:
            inst = parse_instance(toml)
        except InstanceError:
            continue
        if inst.board == d.name:
            return inst.arch
    return None


def _board_summary(text: str) -> str:
    """First line of the board file's header comment.

    Only the head of the file is considered: further down, board.c holds
    implementation commentary that has nothing to do with what the board is.
    """
    m = re.search(r"/\*\s*\n\s*\*?\s*(.{4,110}?)\s*\n", text[:1200])
    return m.group(1).strip() if m else ""


def cmd_list(args: argparse.Namespace) -> int:
    paths = sorted(INSTANCES_DIR.glob("*.toml"))
    if not paths:
        print(f"no instances found in {INSTANCES_DIR}")
        return EXIT_OK
    want_arch = set(args.arch or ())
    want_act = set(args.action or ())
    failed = 0
    shown = 0
    for path in paths:
        try:
            inst = parse_instance(path)
            errors = validate_instance(inst, REPO_ROOT)
        except InstanceError as e:
            failed += 1
            print(f"{path.stem:<28} INVALID  {e}", file=sys.stderr)
            continue
        failed += bool(errors)
        acts = applicable_actions(inst)
        if (want_arch and inst.arch not in want_arch) or (
                want_act and not want_act <= set(acts)):
            continue
        shown += 1
        status = "ok" if not errors else f"{len(errors)} error(s)"
        print(f"{inst.name:<26} {inst.arch:<11} {','.join(acts):<30} "
              f"{status:<11} {inst.description or ''}")
    if not shown and (want_arch or want_act):
        print(f"list: no instance matches arch={sorted(want_arch) or 'any'} "
              f"action={sorted(want_act) or 'any'}", file=sys.stderr)
    if failed:
        print(f"list: {failed} instance(s) invalid", file=sys.stderr)
    return EXIT_FAIL if failed else EXIT_OK


def cmd_check(args: argparse.Namespace) -> int:
    paths = [_resolve(a) for a in args.instances] or sorted(INSTANCES_DIR.glob("*.toml"))
    failed = 0
    covered_arches: set[str] = set()
    registry: tuple[DriverComponent, ...] | None = None
    for path in paths:
        try:
            inst = parse_instance(path)
            errors = validate_instance(inst, REPO_ROOT)
        except InstanceError as e:
            print(f"FAIL {path.name}: {e}", file=sys.stderr)
            failed += 1
            continue
        if inst.rootfs.drivers is not None:
            if registry is None:
                registry = _load_registry()
            errors = errors + validate_driver_selection(inst, registry)
        if errors:
            print(f"FAIL {path.name}: {'; '.join(errors)}", file=sys.stderr)
            failed += 1
        else:
            print(f"OK   {path.name}")
            covered_arches.add(inst.arch)
    for arch in args.require_arch:
        if arch not in covered_arches:
            print(f"FAIL matrix: no valid instance covers required arch '{arch}'",
                  file=sys.stderr)
            failed += 1
    drift = self_check(
        (REPO_ROOT / "Makefile").read_text(encoding="utf-8"),
        (REPO_ROOT / "tools" / "targets-pkg.mk").read_text(encoding="utf-8"),
    )
    for line in drift:
        print(f"FAIL a20_resource: {line}")
    failed += len(drift)
    if failed:
        print(f"check: {failed} failure(s) across {len(paths)} instance(s)",
              file=sys.stderr)
        return EXIT_FAIL
    print(f"check: {len(paths)} instance(s) OK")
    return EXIT_OK


def cmd_check_registry(_args: argparse.Namespace) -> int:
    """Validate the component registry and cross-check it against the Makefile."""
    try:
        entries = load_registry(REPO_ROOT)
    except RegistryError as e:
        print(f"error: components/drivers.toml: {e}", file=sys.stderr)
        return EXIT_FAIL
    errors = validate_registry(entries, REPO_ROOT)
    if errors:
        print(f"error: components/drivers.toml: {'; '.join(errors)}", file=sys.stderr)
        return EXIT_FAIL
    stale = check_make_fragment(entries, REPO_ROOT)
    if stale:
        print(f"error: components/drivers.mk is stale: {'; '.join(stale)}", file=sys.stderr)
        print("hint: run 'a20 regen-drivers' to regenerate it", file=sys.stderr)
        return EXIT_FAIL
    print(f"check-registry: {len(entries)} driver component(s) OK, generated fragment current")
    return EXIT_OK


def cmd_regen_drivers(args: argparse.Namespace) -> int:
    """Regenerate components/drivers.mk from components/drivers.toml."""
    try:
        entries = load_registry(REPO_ROOT)
    except RegistryError as e:
        print(f"error: components/drivers.toml: {e}", file=sys.stderr)
        return EXIT_FAIL
    path = make_fragment_path(REPO_ROOT)
    rendered = render_make_fragment(entries)
    if args.dry_run:
        current = path.read_text() if path.is_file() else ""
        if current == rendered:
            print(f"regen-drivers: {path} is already up to date")
        else:
            print(f"regen-drivers: would rewrite {path} "
                  f"({len(rendered.splitlines())} lines)")
        return EXIT_OK
    try:
        path.write_text(rendered)
    except OSError as e:
        raise A20Error(f"cannot write {path}: {e}") from None
    print(f"regen-drivers: wrote {path}")
    return EXIT_OK


def cmd_check_flash_backends(_args: argparse.Namespace) -> int:
    """Validate the flash-backend registry and cross-check it against the makefiles."""
    try:
        entries = load_flash_backends(REPO_ROOT)
    except RegistryError as e:
        print(f"error: components/flash-backends.toml: {e}", file=sys.stderr)
        return EXIT_FAIL
    try:
        errors = (validate_flash_backends(entries, REPO_ROOT)
                  + cross_check_flash_targets(entries, REPO_ROOT))
    except RegistryError as e:
        print(f"error: components/flash-backends.toml: {e}", file=sys.stderr)
        return EXIT_FAIL
    if errors:
        print(f"error: components/flash-backends.toml: {'; '.join(errors)}",
              file=sys.stderr)
        return EXIT_FAIL
    boards = sorted({b for e in entries for b in e.boards})
    print(f"check-flash-backends: {len(entries)} backend(s) OK covering {len(boards)} board(s): "
          f"{', '.join(boards)}")
    return EXIT_OK


def _add_resource_flags(parser: argparse.ArgumentParser) -> None:
    g = parser.add_argument_group(
        "host resources",
        "Refuse to start a guest the host cannot host. By default a20 waits for "
        "memory, CPU, disk and a free guest slot, because a QEMU that overcommits "
        "gets the OOM killer to pick a victim. Override the budget with "
        "A20_RESERVE_MEM_MB / A20_MAX_CONCURRENT / A20_WAIT_TIMEOUT / A20_MIN_DISK_MB.")
    g.add_argument("--no-wait", action="store_true",
                   help="fail immediately instead of waiting for resources")
    g.add_argument("--wait-timeout", type=float, metavar="SEC",
                   help="give up waiting after SEC seconds (0 waits forever)")


def build_parser() -> argparse.ArgumentParser:
    """The whole CLI tree.  Separated from main() so tab completion (see
    a20_complete) can introspect the real parser instead of a copy of it."""
    parser = argparse.ArgumentParser(
        prog="a20",
        description="Declarative instance runner for A20OS (see docs/instances.md).",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    def add_instance_cmd(name: str, help_text: str, with_make_args: bool) -> argparse.ArgumentParser:
        p = sub.add_parser(name, help=help_text)
        p.add_argument("instance", help="instance name from instances/ or path to a TOML manifest")
        if with_make_args:
            p.add_argument("--dry-run", action="store_true",
                           help="print the make/QEMU command instead of executing it")
        return p

    p_check = sub.add_parser("check", help="validate instance manifests")
    p_check.add_argument("instances", nargs="*", help="manifests to check (default: all)")
    p_check.add_argument("--require-arch", nargs="*", default=(), metavar="ARCH",
                         help="fail unless every listed arch is covered by a valid instance")
    sub.add_parser("check-registry", help="validate components/drivers.toml and its generated make fragment")
    p_regen = sub.add_parser(
        "regen-drivers",
        help="regenerate components/drivers.mk from components/drivers.toml")
    p_regen.add_argument("--dry-run", action="store_true",
                         help="report whether the fragment would change, without writing")
    sub.add_parser("check-flash-backends",
                   help="validate components/flash-backends.toml against the makefiles")
    pl = sub.add_parser("list", help="list known instances")
    pl.add_argument("--arch", nargs="*", default=(), metavar="ARCH",
                    help="only instances built for these architectures")
    pl.add_argument("--action", nargs="*", default=(), metavar="ACT",
                    help="only instances that support every one of these "
                         "actions (build run debug test flash package "
                         "console deploy)")
    p_brd = sub.add_parser("boards", help="list the boards in the tree")
    p_brd.add_argument("--arch", metavar="ARCH",
                       help="only boards for this architecture")
    p_brd.set_defaults(func=cmd_boards)
    sub.add_parser("resources", help="show the host budget instance runs are gated against")

    for name, help_text in (("console", "attach to a board console and run its on-board check"),
                            ("deploy", "program the board, write boot media, then verify it")):
        pc = add_instance_cmd(name, help_text, True)
        pc.add_argument("--no-reset", action="store_true",
                        help="attach without pulsing the board's reset line")
        if name == "deploy":
            pc.add_argument("--no-flash", action="store_true",
                            help="skip the [flash] programming step")

    p_ports = sub.add_parser(
        "ports", help="show which host ports instances claim, and whether they are free now")
    p_ports.add_argument("instance", nargs="*",
                         help="instance names or TOML paths; defaults to every instance")

    p_ledger = sub.add_parser(
        "ledger", help="report an instance's artifacts with size and sha256")
    p_ledger.add_argument("instance", help="instance name from instances/ or path to a TOML manifest")
    p_ledger.add_argument("--format", choices=ledger_formats(), default="table",
                          help="table (human), json (machine), markdown (doc block)")
    p_ledger.add_argument("--out", metavar="FILE", help="write to FILE instead of stdout")
    add_instance_cmd("show", "show what an instance needs and supports",
                   with_make_args=False)
    add_instance_cmd("show-vars", "print derived make variables", with_make_args=False)
    add_instance_cmd("build", "build the instance image", with_make_args=True)
    add_instance_cmd("run", "build and boot the instance in QEMU", with_make_args=True)
    add_instance_cmd("debug", "build with -O0 -g and boot under QEMU GDB stub", with_make_args=True)
    add_instance_cmd("test", "build, boot, inject [test].commands, and check [test].expect",
                     with_make_args=True)
    add_instance_cmd("flash", "build firmware and flash it to the board ([flash] section)",
                     with_make_args=True)
    add_instance_cmd("package", "build and assemble the artifact in [package]",
                     with_make_args=True)

    # Tab completion: `completion` prints the shell shim, `complete` answers
    # one completion query (hidden -- it is plumbing the shim calls).  Both
    # are described in tools/a20_complete.
    p_completion = sub.add_parser(
        "completion", help="print the shell completion script (bash)")
    p_completion.add_argument("shell", nargs="?", choices=("bash",), default="bash",
                              help="shell flavor (zsh works via bashcompinit)")
    p_complete = sub.add_parser("complete", help=argparse.SUPPRESS)
    # help=SUPPRESS alone still lists the command on this argparse (rendered
    # literally as "==SUPPRESS=="); dropping the pseudo action that backs the
    # listing is what actually hides it.  sub.choices keeps the parser, which
    # is all completion introspection needs.
    sub._choices_actions = [a for a in sub._choices_actions
                            if a.dest != "complete"]
    p_complete.add_argument("words", nargs=argparse.REMAINDER,
                            help="words after the program name; last is the word under the cursor")

    # Every command that calls _gate_resources needs the waiting flags, not just
    # the three that launch a guest: build, flash and package are gated too, and
    # omitting them left them crashing on a missing attribute before doing any
    # work at all.
    for gated in ("build", "run", "debug", "test", "flash", "package"):
        _add_resource_flags(sub.choices[gated])

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()

    # Unknown arguments (after an optional `--`) are forwarded to make. Using
    ns, passthrough = parser.parse_known_args(argv)
    # Everything after an explicit "--" is make's.  Anything else that a20 did
    # not recognise is a typo, and forwarding it would hand it to make as a
    # variable override or goal -- so `--dry-rnu` has to be an error, not a
    # silently-ignored flag that changes what gets built.
    if passthrough and passthrough[0] == "--":
        ns.make_args = passthrough[1:]
    elif passthrough:
        parser.error(f"unrecognized argument(s): {' '.join(passthrough)}\n"
                     "a20 flags must be spelled correctly; make arguments go after '--', "
                     "e.g. `a20 build <instance> -- -j8`")
    else:
        ns.make_args = []

    rc = _dispatch(ns)
    # Commands that delegate to make report success by returning None; main()
    # always speaks the exit-code contract, whoever calls it.
    return EXIT_OK if rc is None else rc


def _dispatch(ns: argparse.Namespace) -> int | None:
    match ns.command:
        case "check":
            return cmd_check(ns)
        case "check-registry":
            return cmd_check_registry(ns)
        case "regen-drivers":
            return cmd_regen_drivers(ns)
        case "check-flash-backends":
            return cmd_check_flash_backends(ns)
        case "list":
            return cmd_list(ns)
        case "boards":
            return cmd_boards(ns)
        case "resources":
            return cmd_resources(ns)
        case "console":
            return cmd_console(ns)
        case "deploy":
            return cmd_deploy(ns)
        case "ports":
            return cmd_ports(ns)
        case "ledger":
            return cmd_ledger(ns)
        case "show":
            return cmd_show(ns)
        case "show-vars":
            return cmd_show_vars(ns)
        case "build":
            return cmd_build(ns)
        case "run":
            return cmd_run(ns)
        case "debug":
            return cmd_debug(ns)
        case "test":
            return cmd_test(ns)
        case "flash":
            return cmd_flash(ns)
        case "package":
            return cmd_package(ns)
        case "completion":
            print(BASH_COMPLETION, end="")
            return EXIT_OK
        case "complete":
            for word in completion_candidates(build_parser(), ns.words):
                print(word)
            return EXIT_OK
        case unreachable:
            assert_never(unreachable)


def _run() -> int:
    """main(), with every escape route turned into one operator-facing line.

    Without this the exit status and the message both came from whatever
    exception happened to escape: a missing `make` surfaced as
    `FileNotFoundError: [Errno 2] ... 'make'`, and a make query that the
    Makefile rejected surfaced as a five-frame `a20_make.MakeQueryError`
    traceback.  Both are ordinary operator mistakes with known remedies.
    """
    try:
        return main()
    except A20Error as e:
        return report(e)
    except KeyboardInterrupt:
        print("\ninterrupted", file=sys.stderr)
        return 130
    except BrokenPipeError:
        # `a20 list | head` closes the pipe early; that is not an error.
        try:
            sys.stdout.close()
        finally:
            return EXIT_OK
    except ConsoleError as e:
        return report(BoardUnreachable(str(e)))
    except MakeQueryError as e:
        return report(e)
    except FileNotFoundError as e:
        # Only claim "not on PATH" when the missing name really is a tool we
        # exec.  A bad --out path also raises FileNotFoundError, and telling
        # the operator to install make when their output directory is missing
        # sends them off in exactly the wrong direction.
        name = Path(e.filename).name if e.filename else "?"
        if name in _TOOLS:
            return report(A20Error(f"{name} is not on PATH",
                                   hint=_TOOL_HINT))
        return report(A20Error(f"{e.strerror}: {e.filename}"))
    except OSError as e:
        return report(A20Error(str(e)))


if __name__ == "__main__":
    sys.exit(_run())
