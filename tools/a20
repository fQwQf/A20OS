def _report(inst, result, log) -> int:
    """Print the verdict and keep the transcript either way."""
    write_console_log(log, result.transcript)
    if result.ok:
        print(f"{inst.name}: console OK ({result.stage}); transcript in {log}")
        return EXIT_OK
    print(f"{inst.name}: console FAIL at {result.stage}; missing {list(result.missing)}; "
          f"transcript in {log}", file=sys.stderr)
    print("\n".join(result.transcript.tail(60)), file=sys.stderr)
    return EXIT_FAIL


def cmd_console(args: argparse.Namespace) -> int:
    """Attach to a board's serial console and run the declared on-board check."""
    inst = _load(args.instance)
    if not section_is_set(inst.target):
        raise A20Error(f"{inst.source}: a20 console needs a [target] section",
                       hint="a [target] section declares serial, console_check, "
                            "commands and expect")
    if args.no_reset:
        inst = replace(inst, target=replace(inst.target, reset=None))
    if args.dry_run:
        # Previously ignored: `a20 console --dry-run` opened the real serial
        # port and injected target.commands at a live board, which is the exact
        # opposite of what the flag says.
        t = inst.target
        print(f"would open {t.serial} at {t.baud or 115200} baud")
        if t.reset:
            print(f"would reset: {t.reset}")
        if t.console_check:
            print(f"would wait for prompt: {t.console_check!r} "
                  f"(timeout {t.boot_timeout or '120s'})")
        for cmd in t.commands or ():
            print(f"would send: {cmd}")
        for want in t.expect or ():
            print(f"would require: {want!r}")
        print(f"transcript would go to {console_log_path(inst)}")
        return EXIT_OK
    log = console_log_path(inst)
    try:
        transport = open_transport(inst)
    except OSError as e:
        raise BoardUnreachable(
            f"cannot open console {inst.target.serial!r}: {e}",
            hint="is the board attached, and is this user in the dialout group?") from None
    try:
        result = run_console_session(transport, inst, on_output=_echo)
    except ConsoleError as e:
        transport.close()
        raise BoardUnreachable(str(e)) from None
    return _report(inst, result, log)


def cmd_deploy(args: argparse.Namespace) -> int:
    """Build, program the board, write boot media, then verify it over the console."""
    inst = _load(args.instance)
    if not section_is_set(inst.target):
        raise A20Error(f"{inst.source}: a20 deploy needs a [target] section")
    if inst.target.boot_media and not inst.target.media_device:
        raise A20Error(f"{inst.source}: target.boot_media is declared but "
                       "target.media_device is not, so there is nowhere to write it")
    if not args.no_flash and section_is_set(inst.flash):
        run_flash(inst, _flash_backends(), list(args.make_args), args.dry_run)
    elif section_is_set(inst.flash):
        pass
    elif inst.package.kind and (inst.handoff or inst.target.boot_media):
        # Whatever this instance's artifact is -- a rescue ISO, a bootable disk,
        # a boot bundle -- it has to be assembled before anything can consume it.
        # Both consumers need it: a handoff board loads the bundle, and a board
        # with boot_media writes it to a device.  Keying this on handoff alone
        # left every board that deploys by writing media building a kernel into
        # the build directory and then failing at target-write-media, because the
        # image it named in boot_media had never been produced.
        run_package(inst, list(args.make_args), args.dry_run)
    elif not args.dry_run:
        build_instance(inst, list(args.make_args), args.dry_run)
    if inst.target.boot_media:
        if args.dry_run:
            print(f"would write {' '.join(inst.target.boot_media)} "
                  f"to {inst.target.media_device}")
        else:
            # exec_make raises on failure, so there is no status to check. The
            # `rc = ...; if rc != 0` that used to be here bound None, compared
            # unequal to 0, and returned None -- an accidental exit code 0 that
            # hid the fact this goal was the one call site dropping make args.
            exec_make(inst, "target-write-media", list(args.make_args), args.dry_run)
    if inst.handoff and inst.handoff.commands:
        _handoff_report(inst, args)
    return cmd_console(args)


def _handoff_report(inst, args: argparse.Namespace) -> None:
    """Say what to type at the boot chain, because a20 will not type it.

    A board with no block driver has no medium to write, so the last mile is a
    person interrupting U-Boot and loading the kernel.  Driving that from here
    would mean feeding the boot chain over a serial line this code does not own,
    so the boundary is deliberate: package the artifact, print the commands, and
    let the console check below judge the result.  Printing them from the
    manifest is the point -- the commands on the board are then the commands in
    the repository.
    """
    h = inst.handoff
    print(f"\n{h.method or 'handoff'} for {inst.board}: "
          f"transfer the bundle, then run these at the boot chain.\n")
    if h.server:
        print(f"  server {h.server}")
    for line in h.commands:
        print(f"  {line}")
    if h.note:
        print(f"\n{h.note}")
    print()


def _port_note(inst) -> str:
    """One line describing what host ports this instance will claim.

    Printed before launch because with the default no longer claiming 5555, the
    port a guest is reachable on is a property of the instance, and the operator
    needs to see it rather than infer it.
    """
    entries = inst.net.hostfwd or ()
    if not entries:
        return f"{inst.name}: no host port forwarding (nothing to connect to)"
    return f"{inst.name}: host forwarding {', '.join(entries)}"


def cmd_ports(args: argparse.Namespace) -> int:
    """Show which host ports instances claim, and whether they are free now.

    Two instances declaring the same port is a legitimate choice -- you may only
    ever run one of them at a time -- so this reports rather than fails.  It
    exists because the failure mode otherwise shows up as QEMU refusing to bind
    several minutes into a build.
    """
    from a20_resource import busy_ports, parse_hostfwd_ports
    names = list(getattr(args, "instance", None) or ())
    paths = [Path(n) for n in names] if names else sorted(INSTANCES_DIR.glob("*.toml"))
    claimed: dict[tuple[str, int], list[str]] = {}
    rows: list[tuple[str, str, str]] = []
    bad = 0
    for path in paths:
        try:
            inst = _load(str(path))
        except A20Error as e:
            bad += 1
            rows.append((path.stem, "-", f"invalid manifest: {e}"))
            continue
        want = parse_hostfwd_ports(inst.net.hostfwd)
        if not want:
            state = "ephemeral" if inst.net.hostfwd else "none"
            rows.append((inst.name, state, "declares no fixed host port"))
            continue
        busy = set(busy_ports(want))
        for addr, port in want:
            # tcp and udp forwards of one instance share a port number; list the
            # instance once so the collision note reads as "who", not "how many".
            holders = claimed.setdefault((addr, port), [])
            if inst.name not in holders:
                holders.append(inst.name)
            rows.append((inst.name, f"{addr}:{port}",
                         "IN USE" if (addr, port) in busy else "free"))
    width = max((len(r[0]) for r in rows), default=10)
    for name, where, state in rows:
        print(f"{name:<{width}}  {where:<22} {state}")
    clashes = {k: v for k, v in claimed.items() if len(v) > 1}
    if clashes:
        print()
        for (addr, port), names in sorted(clashes.items()):
            print(f"note: {addr}:{port} is claimed by {', '.join(sorted(names))}"
                  " -- fine if you never run them together, otherwise give one an ephemeral"
                  " port (hostfwd = [\"tcp::0-<guestport>\"])", file=sys.stderr)
    if bad:
        print(f"ports: {bad} instance(s) could not be read", file=sys.stderr)
        return EXIT_FAIL
    return EXIT_OK

def cmd_ledger(args: argparse.Namespace) -> int:
    """Report what an instance actually produced: sizes, hashes, revision."""
    manifest = collect_manifest(_load(args.instance))
    if args.format == "json":
        text = render_json(manifest)
    elif args.format == "markdown":
        text = render_markdown(manifest)
    else:
        text = render_table(manifest)
    if args.out:
        write_ledger(manifest, Path(args.out), args.format)
        print(f"{manifest.instance}: ledger written to {args.out}")
    else:
        print(text)
    return 0 if manifest.artifacts else 1


