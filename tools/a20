def cmd_show(args: argparse.Namespace) -> int:
    """Everything an operator needs before choosing a command, in one screen.

    `show-vars` answers "what would make see"; this answers "can I run this, what
    will it cost me, and what will it touch" -- the questions that come first
    when picking between 46 instances.
    """
    inst = _load(args.instance)
    acts = applicable_actions(inst)
    print(f"{inst.name}  [{inst.arch}]  {inst.description or ''}")

    from a20_resource import Policy, parse_hostfwd_ports, requirement_for
    need = requirement_for(inst, Policy.from_env())
    print(f"  actions     {', '.join(acts)}")
    print(f"  board       {inst.board or default_board(inst.arch)}")
    print(f"  needs       {need.describe()}")

    ports = parse_hostfwd_ports(inst.net.hostfwd)
    print(f"  host ports  {', '.join(f'{a}:{p}' for a, p in ports) if ports else 'none (nothing to connect to)'}")

    if inst.target and section_is_set(inst.target):
        t = inst.target
        print(f"  console     {t.serial} at {t.baud or 115200} baud"
              f"{', resets the board' if t.reset else ''}")
        if t.boot_media:
            print(f"  boot media  {' '.join(t.boot_media)} -> {t.media_device or '(unset!)'}")
        if t.expect:
            print(f"  expects     {', '.join(t.expect)}")
    if inst.flash.tool:
        print(f"  flashes via {inst.flash.tool}")
    if inst.test.expect:
        print(f"  smoke waits {', '.join(inst.test.expect)}")
    print(f"  manifest    {inst.source}")
    return EXIT_OK


