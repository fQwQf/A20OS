INSTANCES_DIR = REPO_ROOT / "instances"

# Tools a20 execs.  Used only to decide whether a FileNotFoundError means
# "install it" or "you named a path that isn't there".
_TOOLS = frozenset({"make", "git"})
_TOOL_HINT = "a20 shells out to make and git; install them or fix PATH"


def _known_names() -> list[str]:
    return sorted(p.stem for p in INSTANCES_DIR.glob("*.toml"))


def _resolve(arg: str) -> Path:
    """Accept either a manifest path or an instance name from instances/."""
    p = Path(arg)
    if p.is_file():
        return p
    candidate = INSTANCES_DIR / f"{arg}.toml"
    if candidate.is_file():
        return candidate
    # A near-miss is almost always a typo or a half-remembered name; there are
    # dozens of instances, so guessing beats making the user go and list them.
    # 0.75 rather than something looser: at 0.6 a name that is not an instance
    # at all (`smoke-poll-edge` is a make target) came back with a confident,
    # wrong suggestion, which is worse than no suggestion.
    close = difflib.get_close_matches(arg, _known_names(), n=3, cutoff=0.75)
    hint = f"did you mean: {', '.join(close)}?" if close else "run 'a20 list' to see them"
    raise A20Error(f"no such instance '{arg}' (tried {arg} and {candidate})", hint=hint)


def _load_registry() -> tuple[DriverComponent, ...]:
    try:
        entries = load_registry(REPO_ROOT)
    except RegistryError as e:
        raise A20Error(f"component registry: {e}") from None
    errors = validate_registry(entries, REPO_ROOT)
    if errors:
        listing = "; ".join(errors)
        raise A20Error(f"component registry: {listing}")
    return entries


def _load(arg: str) -> Instance:
    path = _resolve(arg)
    try:
        inst = parse_instance(path)
    except InstanceError as e:
        raise A20Error(f"{path}: {e}") from None
    errors = validate_instance(inst, REPO_ROOT)
    if inst.rootfs.drivers is not None:
        errors = errors + validate_driver_selection(inst, _load_registry())
    if errors:
        listing = "; ".join(errors)
        raise A20Error(f"{path}: {listing}")
    return inst


def _check_runnable(inst: Instance, action: str) -> None:
    if inst.arch not in QEMU_RUNNABLE_ARCHES:
        raise A20Error(
            f"'{action}' has no generic QEMU path for {inst.arch}",
            hint="armv7m runs through tools/stm32.mk ([stm32] qemu = true); "
                 "loongarch32 runs on the cemu simulator, not QEMU")


def _gate_resources(inst, args, *, guest: bool = True) -> None:
    """Refuse to start work the host cannot afford, waiting if allowed to.

    `guest=True` is the launch gate -- memory, CPU, guest slots and the host
    ports this instance claims, because a QEMU that overcommits gets the OOM
    killer to choose a victim.  `guest=False` is the build gate: disk only, so
    `a20 package` is not blocked by a guest that happens to be running.

    A dry run must not block.  `--dry-run` promises to print the command rather
    than execute it, and waiting for a resource it will never consume is both a
    lie about what it does and, with the default unlimited wait, an apparent
    hang.
    """
    if getattr(args, "dry_run", False):
        return
    policy = Policy.from_env()
    if getattr(args, "wait_timeout", None) is not None:
        policy = Policy(policy.reserve_mem_mb, policy.min_disk_mb,
                        policy.max_concurrent, args.wait_timeout)
    preflight(inst, policy, REPO_ROOT, wait=not getattr(args, "no_wait", False),
              echo=_echo, guest=guest)
def _gate_qemu(inst: Instance, action: str) -> None:
    """Block until the host can host this instance; see tools/a20_resource.gate_qemu."""
    m = inst.machine
    memory = m.memory
    if memory is None:
        memory = DEFAULT_MEMORY_GUI if (inst.gui.enabled or inst.rootfs.world) else DEFAULT_MEMORY
    # A world image lives at build/images/<world>-<arch>.img; check it before
    # boot, because a dirty one presents as a kernel bug rather than as a
    # filesystem problem.  Its absence is not an error here: cmd_run builds
    # the image itself, so on a first run there is nothing to check yet.
    image = None
    if inst.rootfs.world is not None:
        image = REPO_ROOT / "build" / "images" / f"{inst.rootfs.world}-{inst.arch}.img"
    gate_qemu(memory=memory, vcpus=m.smp or DEFAULT_VCPUS,
              disk_path=str(REPO_ROOT), image=image,
              label=f"{inst.name} ({action})", echo=_echo)


def _echo(msg: str) -> None:
    print(msg, flush=True)


def cmd_resources(_args: argparse.Namespace) -> int:
    """Report the host budget a20 will gate instance runs against."""
    policy = Policy.from_env()
    have = HostResources.snapshot(REPO_ROOT)
    cap = policy.max_concurrent or max(1, have.cpu_count // 4)
    print(f"memory available : {have.mem_available_mb} MiB "
          f"(+{policy.reserve_mem_mb} MiB reserved per run)")
    print(f"cpu              : {have.cpu_count} online, load {have.load1:.1f}")
    print(f"guest slots      : {cap - have.running_guests} free of {cap} "
          f"({have.running_guests} running)")
    print(f"disk free        : {have.disk_free_mb} MiB "
          f"(floor {policy.min_disk_mb} MiB per run)")
    print(f"wait timeout     : "
          f"{'forever' if policy.wait_timeout_s <= 0 else f'{policy.wait_timeout_s:.0f}s'}")
    return EXIT_OK


def cmd_build(args: argparse.Namespace) -> None:
    inst = _load(args.instance)
    _gate_resources(inst, args, guest=False)
    build_instance(inst, list(args.make_args), args.dry_run)


def cmd_run(args: argparse.Namespace) -> None:
    inst = _load(args.instance)
    if inst.arch == "armv7m":
        if not inst.stm32.qemu:
            raise A20Error(
                f"{inst.source}: armv7m has no generic QEMU path",
                hint="set [stm32] qemu = true to run on the stm32vldiscovery machine")
        _gate_resources(inst, args)
        build_instance(inst, list(args.make_args), args.dry_run)
        exec_make(inst, "run-stm32f103-qemu-impl",
                 list(args.make_args), args.dry_run)
        return
    _check_runnable(inst, "run")
    _gate_resources(inst, args)
    _echo(_port_note(inst))
    _gate_qemu(inst, "run")
    if inst.rootfs.world is not None:
        # apk world images boot as the second disk; init chroots into them.
        target = "run-world-gui" if inst.gui.enabled else "run-world"
        exec_make(inst, target, list(args.make_args), args.dry_run)
        return
    exec_make(inst, "_run_impl", list(args.make_args), args.dry_run)


