% ---- A20OS palette: clean light academic look ----
\definecolor{a20accent}{HTML}{174A75}      % restrained academic blue
\definecolor{a20accentlight}{HTML}{3976A5}
\definecolor{a20gold}{HTML}{D39A2C}        % warm logo accent
\definecolor{a20ink}{HTML}{20252B}         % near-black body text
\definecolor{a20muted}{HTML}{66727F}       % secondary text
\definecolor{a20rule}{HTML}{D8E0E7}        % subtle rule lines
\definecolor{a20codebg}{HTML}{F5F7F9}      % code block background
\definecolor{a20tablehead}{HTML}{EDF3F8}

\linespread{1.05}\selectfont
\ifdefined\setlist
\setlist{topsep=0.45em,itemsep=0.2em,parsep=0pt}
\fi

% ---- headers and footers ----
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{a20rule}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\small\color{a20muted}A20OS \textbar\ 标准参考手册}
\fancyhead[R]{\small\color{a20muted}\nouppercase{\leftmark}}
\ifdefined\chaptermark
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\fi
\fancyfoot[C]{\small\color{a20muted}\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\small\color{a20muted}\thepage}
  \renewcommand{\headrulewidth}{0pt}}

% ---- document hierarchy: every Markdown H1 is a chapter ----
% Mixed typeface scheme: serif body, sans-serif headings, mono code.
\ifdefined\titleformat
\ifdefined\chapter
\titleformat{\chapter}[display]
  {\normalfont\sffamily\bfseries\color{a20ink}}
  {\Large\color{a20accent}第\thechapter 章}
  {1.4ex}
  {\Huge}
  [{\vspace{1.2ex}\color{a20rule}\titlerule}]
\titlespacing*{\chapter}{0pt}{0pt}{4.2ex}
\fi
\titleformat{\section}
  {\Large\sffamily\bfseries\color{a20ink}}{\color{a20accent}\thesection}{0.7em}{}
\titleformat{\subsection}
  {\large\sffamily\bfseries\color{a20ink}}{\color{a20accent}\thesubsection}{0.7em}{}
\titleformat{\subsubsection}
  {\normalsize\sffamily\bfseries\color{a20ink}}{\color{a20accent}\thesubsubsection}{0.7em}{}
\titlespacing*{\section}{0pt}{3.0ex plus 1ex minus .2ex}{1.05ex}
\titlespacing*{\subsection}{0pt}{2.2ex plus .8ex minus .2ex}{0.75ex}
\titlespacing*{\subsubsection}{0pt}{1.6ex plus .6ex minus .2ex}{0.5ex}
\fi

% ---- table of contents: keep a clear gap between number and title ----
\makeatletter
\renewcommand*\numberline[1]{%
  \hb@xt@\@tempdima{#1\hfil}%
  \hspace*{0.5em}%
}
% Chapters are the only TOC level (toc-depth=0); style them as headings.
\renewcommand*\l@chapter[2]{%
  \ifnum \c@tocdepth >\m@ne
    \addpenalty{-\@highpenalty}%
    \vskip 1.0em \@plus\p@
    \setlength\@tempdima{1.5em}%
    \begingroup
      \parindent \z@ \rightskip \@pnumwidth
      \parfillskip -\@pnumwidth
      \leavevmode\sffamily\bfseries
      \advance\leftskip\@tempdima
      \hskip -\leftskip
      #1\nobreak\hfil \nobreak\hb@xt@\@pnumwidth{\hss #2}\par
      \penalty\@highpenalty
    \endgroup
  \fi}
\makeatother

% ---- hyperlinks ----
\AtBeginDocument{\hypersetup{linkcolor=a20accent,urlcolor=a20accentlight,colorlinks=true}}

% ---- code blocks: light background with a thin border ----
$if(highlighting-macros)$
\colorlet{shadecolor}{a20codebg}
\AtBeginDocument{%
  \ifdefined\RecustomVerbatimEnvironment
    \RecustomVerbatimEnvironment{Highlighting}{Verbatim}{%
      commandchars=\\\{\},
      breaklines=true,
      breakanywhere=true,
      breaksymbolleft={\tiny\color{a20muted}\ensuremath{\hookrightarrow}\space},
      fontsize=\small
    }%
  \fi
  \ifdefined\renewenvironment
  \IfFileExists{framed.sty}{%
    \renewenvironment{Shaded}{\begin{snugshade}}{\end{snugshade}}%
  }{}%
  \fi
}
$endif$

% ---- display math: break multiline equations; scale oversized single lines ----
\AtBeginDocument{%
