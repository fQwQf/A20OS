\makeatletter
\newcommand{\aosSubtitle}{}
\newcommand{\aosSubject}{}
\renewcommand{\maketitle}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \sffamily
    \vspace*{0.08\textheight}
    $if(a20-logo)$
    \includegraphics[height=2.9cm]{$a20-logo$}\par
    \vspace{0.7cm}
    $endif$
    \vspace{0.7cm}
    {\color{a20accent}\rule{\textwidth}{1.4pt}\par}
    \vspace{1.45cm}
    {\fontsize{34}{42}\selectfont\bfseries\color{a20ink}\@title\par}
    \vspace{0.7cm}
    {\Large\color{a20accent}\aosSubtitle\par}
    \vspace{0.5cm}
    {\large\color{a20muted}\aosSubject\par}
    \vfill
    \begin{minipage}{0.62\textwidth}
      \color{a20muted}\small
      \renewcommand{\arraystretch}{1.35}
      \begin{tabular}{@{}ll@{}}
        文档类型 & 技术手册 \\
        生成日期 & \@date \\
        发布主体 & \@author
      \end{tabular}
    \end{minipage}\par
    \vspace{0.8cm}
    {\color{a20rule}\rule{\textwidth}{0.5pt}\par}
  \end{titlepage}}
\makeatother
