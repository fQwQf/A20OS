diff --git a/kernel/mm/cow.c b/kernel/mm/cow.c
index 6c197eea..5762137b 100644
--- a/kernel/mm/cow.c
+++ b/kernel/mm/cow.c
@@ -354,13 +354,20 @@ void a20_cow_share_downgrade(void *parent_ptr, uintptr_t va, int level,
     uintptr_t pa = snapshot->pa;
 #ifdef ARCH_HAS_PTE_BLOCK
     size_t leaf_size = vm_pt_level_size(level);
-    *src_pte = (leaf_size >= PMD_SIZE)
-                   ? arch_pte_block((paddr_t)pa, (pte_t)flags)
-                   : arch_pte_leaf((paddr_t)pa, (pte_t)flags);
+    pte_t replacement = (leaf_size >= PMD_SIZE)
+                            ? arch_pte_block((paddr_t)pa, (pte_t)flags)
+                            : arch_pte_leaf((paddr_t)pa, (pte_t)flags);
 #else
-    *src_pte = arch_pte_leaf((paddr_t)pa, (pte_t)flags);
+    pte_t replacement = arch_pte_leaf((paddr_t)pa, (pte_t)flags);
 #endif
-    mm_tlb_note_change(parent, va, vm_pt_level_size(level));
+    /* Repeated forks commonly find an already-COW leaf. Compare the encoded
+     * entry, not just its COW bit: flags such as D may still require clearing.
+     * An unchanged entry needs neither a store nor another TLB invalidation;
+     * metadata refresh below remains necessary even on this path. */
+    if (*src_pte != replacement) {
+        *src_pte = replacement;
+        mm_tlb_note_change(parent, va, vm_pt_level_size(level));
+    }
 #if defined(ARCH_HAS_PGTABLE_OPS)
     if (snapshot->node)
         (void)mm_pt_sync_status(snapshot->node, level, arch_pt_vpn(va, level),
