diff --git a/kernel/include/core/bottleneck_profile.h b/kernel/include/core/bottleneck_profile.h
new file mode 100644
--- /dev/null
+++ b/kernel/include/core/bottleneck_profile.h
@@ -0,0 +1,22 @@
+#ifndef A20_BOTTLENECK_PROFILE_H
+#define A20_BOTTLENECK_PROFILE_H
+#include "core/perf.h"
+#include "core/timer.h"
+typedef struct { uint64_t count; uint64_t ticks; } bp_stat_t;
+enum bp_stage { BP_YIELD, BP_SCHED_PREPARE_PICK, BP_CLONE, BP_CLONE_MM, BP_CLONE_ARCH, BP_MM_FORK, BP_FORK_ALLOC_PREPARE, BP_FORK_VMAS, BP_FORK_PTES, BP_FORK_TLB_FINISH, BP_MM_DESTROY, BP_DESTROY_VMAS, BP_DESTROY_PT, BP_WAIT_REAP, BP_FUTEX_WAKE, BP_COUNT };
+#if CONFIG_BOTTLENECK_PROFILE
+extern bp_stat_t g_bp[A20_PERF_MAX_CPUS][BP_COUNT];
+static inline uint64_t bp_now(void) { return __atomic_load_n(&g_a20_perf_enabled, __ATOMIC_RELAXED) ? timer_get_ticks() : 0; }
+static inline void bp_record(enum bp_stage stage, uint64_t start) {
+    if (!start) return;
+    uint64_t end = timer_get_ticks();
+    unsigned cpu = arch_current_cpu_id();
+    if (cpu >= A20_PERF_MAX_CPUS) cpu = 0;
+    __atomic_fetch_add(&g_bp[cpu][stage].count, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&g_bp[cpu][stage].ticks, end >= start ? end - start : 0, __ATOMIC_RELAXED);
+}
+#else
+static inline uint64_t bp_now(void) { return 0; }
+static inline void bp_record(enum bp_stage stage, uint64_t start) { (void)stage; (void)start; }
+#endif
+#endif
