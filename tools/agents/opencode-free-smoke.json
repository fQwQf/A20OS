{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/space-bunny-free",
  "small_model": "opencode/space-bunny-free",
  "enabled_providers": [
    "opencode"
  ],
  "disabled_providers": [],
  "autoupdate": false,
  "snapshot": false,
  "plugin": [],
  "mcp": {},
  "default_agent": "free-smoke",
  "permission": {
    "*": "deny",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "agent": {
    "free-smoke": {
      "description": "Short free-model connectivity check with every tool disabled.",
