{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/space-bunny-free",
  "small_model": "opencode/space-bunny-free",
  "enabled_providers": [
    "opencode"
  ],
  "disabled_providers": [],
  "autoupdate": false,
  "snapshot": false,
  "plugin": [],
  "mcp": {},
  "default_agent": "free-readonly",
  "permission": {
    "*": "deny",
    "read": {
      "*": "deny",
      "README.md": "allow",
      "Makefile": "allow",
      ".github/workflows/*.yml": "allow",
      "components/*.toml": "allow",
      "components/*.mk": "allow",
      "docs/**/*.md": "allow",
      "instances/*.toml": "allow",
      "tools/*.py": "allow",
      "tools/*.mk": "allow",
      "tools/a20": "allow",
      "tools/agents/README.md": "allow",
      "kernel/**/*.c": "allow",
      "kernel/**/*.h": "allow",
      "kernel/**/*.rs": "allow",
      "kernel/**/*.S": "allow",
      "kernel/**/*.s": "allow",
      "user/**/*.c": "allow",
      "user/**/*.h": "allow",
      "user/**/*.rs": "allow",
      "**/.git/**": "deny",
      ".git/**": "deny",
      "**/build/**": "deny",
      "build/**": "deny",
      ".kernel-build/**": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/auth.json": "deny",
      "**/*credentials*": "deny",
      "**/*secret*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "agent": {
    "free-readonly": {
      "description": "Free-model read-only repository audit. Follow the task's exact file scope; do not write, execute commands, delegate, or access external paths.",
      "mode": "primary",
      "model": "opencode/space-bunny-free",
      "prompt": "You are a read-only reviewer for this repository. Read only the exact in-repository paths required by the user's prompt. Do not request credentials, inspect hidden/system data, write files, execute commands, delegate, or suggest that you performed checks you did not run. Return concise findings with repository path and line references.",
      "tools": {
        "*": false,
        "read": true
      },
      "permission": {
        "*": "deny",
        "read": "allow",
        "external_directory": "deny",
        "doom_loop": "deny"
      }
    }
  }
}
