diff --git a/kernel/mm/cow.c b/kernel/mm/cow.c
index 72db789c..d5223ffe 100644
--- a/kernel/mm/cow.c
+++ b/kernel/mm/cow.c
@@ -306,12 +306,16 @@ int a20_cow_share_snapshot(void *parent_ptr, uintptr_t va, int level,
         return 0;
     memset(out, 0, sizeof(*out));
     out->pfn = PFN_NONE;
-    pte_t *src_pte = pt_lookup_leaf(parent->pgdir, va, NULL, NULL, NULL);
+    int source_level = 0;
+    pte_t *src_pte = pt_lookup_leaf(parent->pgdir, va, &source_level, NULL, NULL);
     if (!src_pte)
         return 0;
     pte_t *stab = NULL;
 #if defined(ARCH_HAS_PGTABLE_OPS)
-    stab = mm_pt_leaf_table(parent->pgdir, va);
+    /* The walker returned &table[vpn(va, source_level)]. Recover that exact
+     * table by array subtraction, including huge leaves, instead of walking
+     * from the root again. No table-size/alignment assumption is required. */
+    stab = src_pte - arch_pt_vpn(va, source_level);
     if (stab)
         mm_pt_node_lock(stab);
 #endif
