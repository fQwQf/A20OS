diff --git a/libweston/libinput-seat.c b/libweston/libinput-seat.c
index 9801551..8f937f4 100644
--- a/libweston/libinput-seat.c
+++ b/libweston/libinput-seat.c
@@ -337,4 +337,23 @@ udev_input_init(struct udev_input *input, struct weston_compositor *c,
-	input->libinput = libinput_udev_create_context(&libinput_interface,
-						       input, udev);
-	if (!input->libinput) {
-		return -1;
+	if (getenv("WESTON_LIBINPUT_UDEV")) {
+		input->libinput = libinput_udev_create_context(&libinput_interface,
+							       input, udev);
+		if (!input->libinput)
+			return -1;
+		if (libinput_udev_assign_seat(input->libinput, seat_id) != 0) {
+			libinput_unref(input->libinput);
+			return -1;
+		}
+	} else {
+		/* A20OS: no udev device database.  Use the libinput path
+		 * backend with the evdev multiplexer device directly. */
+		const char *a20_dev = getenv("WESTON_LIBINPUT_DEVICE");
+		if (!a20_dev)
+			a20_dev = "/dev/event0";
+		input->libinput = libinput_path_create_context(&libinput_interface,
+							       input);
+		if (!input->libinput)
+			return -1;
+		if (!libinput_path_add_device(input->libinput, a20_dev)) {
+			libinput_unref(input->libinput);
+			return -1;
+		}
@@ -357,5 +375,0 @@ udev_input_init(struct udev_input *input, struct weston_compositor *c,
-	if (libinput_udev_assign_seat(input->libinput, seat_id) != 0) {
-		libinput_unref(input->libinput);
-		return -1;
-	}
-
