// Shared Native service constants. Version changes require protocol review.
interface a20_services version 1 {
  message ENVELOPE {
    u16 version;
    u16 type;
    u32 size;
  }
  const A20_SVC_CRASH_CODE = 42;
  const RTCD_REQ_TIME = 0x54;
  const RTCD_REQ_ALARM = 0x41;
  const RTCD_REQ_CRASH = 0x43;
  const RTCD_REPLY_TIME = 0x61;
  const RTCD_REPLY_ALARM = 0x62;
  const UBD_REQ_READ = 0x52;
  const UBD_REQ_WRITE = 0x57;
  const UBD_REQ_CRASH = 0x43;
  message RTCD_ALARM_REQUEST {
    u32 milliseconds;
  }
  message RTCD_TIME_RESPONSE {
    u64 seconds;
    u64 nanoseconds;
  }
  message SVCMGR_ECHO {
    u32 seq;
  }
  const SVCMGR_REQ_ECHO = 0x21;
  const SVCMGR_REQ_CRASH = 0x22;
  // Binding slots: task_spawn target_slot values, one service each.
  // Slot numbers are global conventions; the ping channel shares 41 with
  // the shmring VMO because they belong to different service tasks.
  const A20_SVC_ENDPOINT_SLOT = A20_NATIVE_FD_HANDLE_BASE + 40u;
  const A20_SVC_PING_SLOT = A20_NATIVE_FD_HANDLE_BASE + 41u;
  const A20_SHMRING_VMO_SLOT = A20_NATIVE_FD_HANDLE_BASE + 41u;
  const A20_CHAND_EP_SLOT = A20_NATIVE_FD_HANDLE_BASE + 42u;
  const A20_RTCD_EP_SLOT = A20_NATIVE_FD_HANDLE_BASE + 43u;
  const A20_UBD_EP_SLOT = A20_NATIVE_FD_HANDLE_BASE + 44u;
  // shmring benchmark geometry shared by shmringd/chand/test drivers.
  const A20_SHMRING_VMO_SIZE = 1024u * 1024u;
  const A20_SHMRING_CAP = 512u * 1024u;
  const A20_SHMRING_TOTAL = 16u * 1024u * 1024u;
}
