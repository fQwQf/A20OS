"""A20OS Wi-Fi window for GTK 3 / XFCE Wayland."""
import os
import threading
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gio

from wifi_backend import Radio
import wifi_portal


def action_log(message):
    # Correlate clicks with input/bus health without recording credentials.
    try:
        fd = os.open("/dev/kmsg", os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            os.write(fd, ("[WIFI-GUI] " + message + "\n").encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def visible_ssid(value):
    return "".join(c if ord(c) >= 32 and ord(c) != 127 else "�"
                   for c in value.decode("utf-8", "replace"))


def run_dialog(dialog):
    # PyGObject's Dialog.run override installs a signal wakeup socket. Use
    # the same GLib context loop as the main window on the A20OS Linux ABI.
    response = []
    handler = dialog.connect("response", lambda _, value: response.append(value))
    context = GLib.MainContext.default()
    while not response:
        context.iteration(True)
    dialog.disconnect(handler)
    return response[0]


class WifiWindow(Gtk.ApplicationWindow):
    def __init__(self, application, radio=None, detector=None, browser=None):
        super().__init__(application=application, title="Wi-Fi 网络")
        self.radio = radio or Radio()
        self.detector = detector or (lambda: wifi_portal.detect(api=wifi_portal.capport_uri()))
        self.browser = browser or wifi_portal.open_login
        self.login_url = wifi_portal.MANUAL_LOGIN
        self.connected = False
        self.busy = False
        self.set_default_size(720, 500)
        self.set_border_width(18)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(box)
        title = Gtk.Label(label="选择无线网络", xalign=0)
        title.get_style_context().add_class("title")
        box.pack_start(title, False, False, 0)
        self.status_label = Gtk.Label(label="正在读取无线状态…", xalign=0)
        self.status_label.set_line_wrap(True)
        box.pack_start(self.status_label, False, False, 0)
        hint = Gtk.Label(label="开放热点可能需要网页认证：连接后可在浏览器中完成。", xalign=0)
        hint.set_line_wrap(True)
        box.pack_start(hint, False, False, 0)
        self.store = Gtk.ListStore(str, str, str, object)
        self.networks = Gtk.TreeView(model=self.store)
        for number, label in enumerate(("网络名称", "安全类型", "信号")):
            renderer = Gtk.CellRendererText()
            column = Gtk.TreeViewColumn(label, renderer, text=number)
            column.set_expand(number == 0)
            self.networks.append_column(column)
        self.networks.connect("row-activated", lambda *_: self.join_selected())
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.networks)
        box.pack_start(scroll, True, True, 0)
        actions = Gtk.Box(spacing=8)
        self.buttons = []
        for label, callback in (("刷新热点", self.refresh), ("连接", self.join_selected),
                                ("断开", self.disconnect), ("检测网络", self.check_network)):
            button = Gtk.Button(label=label)
            button.connect("clicked", lambda _, fn=callback: fn())
            actions.pack_start(button, False, False, 0)
            self.buttons.append(button)
        self.login_button = Gtk.Button(label="打开认证网页")
        self.login_button.connect("clicked", lambda *_: self.open_portal())
        actions.pack_end(self.login_button, False, False, 0)
        diagnostic = Gtk.Button(label="诊断日志")
        diagnostic.connect("clicked", lambda *_: self.diagnostics())
        actions.pack_start(diagnostic, False, False, 0)
        box.pack_start(actions, False, False, 0)
        self.address = Gtk.Entry()
        self.address.set_placeholder_text("认证页未自动打开时，可输入学校提供的 http:// 或 https:// 地址")
        self.address.connect("activate", lambda *_: self.open_portal())
        box.pack_start(self.address, False, False, 0)
        self.show_all()
        GLib.idle_add(self.refresh)

    def work(self, message, operation, done, phase="unknown"):
        if self.busy:
            return
        self.busy = True
        for button in self.buttons:
            button.set_sensitive(False)
        self.status_label.set_text(message)
        def worker():
            try:
                result, error = operation(), None
            except Exception as exception:
                trace = exception.__traceback__
                while trace and trace.tb_next:
                    trace = trace.tb_next
                where = f"{Path(trace.tb_frame.f_code.co_filename).name}:{trace.tb_lineno}" if trace else "unknown"
                detail = f"phase={phase} type={type(exception).__name__} errno={getattr(exception, 'errno', None)} at={where}"
                result, error = None, (str(exception), detail)
            GLib.idle_add(finish, result, error)
        def finish(result, error):
            self.busy = False
            for button in self.buttons:
                button.set_sensitive(True)
            if error:
                action_log("operation failed " + error[1])
                self.status_label.set_text(error[0])
            else:
                done(result)
            return False
        threading.Thread(target=worker, daemon=True).start()

    def refresh(self):
        action_log("refresh requested")
        def operation():
            status = self.radio.status()
            return status, self.radio.scan()
        def done(result):
            status, networks = result
            self.connected = status.get("authorized") == "1" and status.get("ip", "none") != "none"
            self.store.clear()
            for network in networks:
                security = network["security"]
                name = ("开放 / 可能需网页认证" if security == 0 else
                        "企业认证（暂不支持）" if security & 8 else
                        "WPA2 / WPA3" if security & 6 else "旧式加密（暂不支持）")
                self.store.append([visible_ssid(network["ssid"]), name,
                                   f'{network["signal"]} dBm', network])
            if len(self.store):
                self.networks.get_selection().select_path(0)
            self.status_label.set_text("已连接，点击“检测网络”检查网页认证状态" if self.connected else
                                       f"找到 {len(networks)} 个热点，请选择并连接")
        self.work("正在扫描附近的 Wi-Fi…", operation, done, phase="scan")
        return False

    def join_selected(self):
        action_log("connect requested")
        model, row = self.networks.get_selection().get_selected()
        if row is None or self.busy:
            return
        network = model[row][3]
        security = network["security"]
        if security & 8 or (security and not security & 6):
            self.status_label.set_text("这个热点的无线加密方式暂未支持，请选择开放或 WPA2/WPA3 热点")
            return
        password = b""
        if security:
            dialog = Gtk.Dialog(title="输入 Wi-Fi 密码", transient_for=self, modal=True)
            dialog.add_buttons("取消", Gtk.ResponseType.CANCEL, "连接", Gtk.ResponseType.OK)
            entry = Gtk.Entry()
            entry.set_visibility(False)
            entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
            entry.set_activates_default(True)
            dialog.set_default_response(Gtk.ResponseType.OK)
            dialog.get_content_area().pack_start(entry, False, False, 12)
            dialog.show_all()
            response = run_dialog(dialog)
            if response == Gtk.ResponseType.OK:
                password = entry.get_text().encode("utf-8")
            entry.set_text("")
            dialog.destroy()
            if response != Gtk.ResponseType.OK:
                return
        def operation():
            self.radio.connect(network["ssid"], password)
        def done(_):
            self.connected = True
            self.check_network(automatic=True)
        self.work(f'正在连接 {visible_ssid(network["ssid"])} 并获取网络地址…', operation, done, phase="connect")

    def disconnect(self):
        action_log("disconnect requested")
        def done(_):
            self.connected = False
            self.login_url = wifi_portal.MANUAL_LOGIN
            self.address.set_text("")
            self.status_label.set_text("Wi-Fi 已断开")
        self.work("正在断开…", self.radio.disconnect, done, phase="disconnect")

    def check_network(self, automatic=False):
        action_log("network check requested")
        def operation():
            status = self.radio.status()
            action_log("network status authorized=" + str(status.get("authorized", "missing")) +
                       " address_present=" + str(status.get("ip", "none") != "none"))
            if status.get("authorized") != "1" or status.get("ip", "none") == "none":
                raise OSError("请先连接 Wi-Fi 并取得网络地址")
            return self.detector()
        def done(result):
            self.connected = True
            self.login_url = result["login_url"]
            self.address.set_text("")
            self.status_label.set_text(result["message"])
            if automatic and result["state"] in ("portal", "unknown"):
                self.open_portal()
        self.work("正在检测外网与网页认证…", operation, done, phase="network")

    def open_portal(self):
        action_log("login page requested")
        url = self.address.get_text().strip() or self.login_url
        try:
            self.browser(url)
            self.status_label.set_text("已打开 Firefox。完成校园网登录后，点击“检测网络”确认是否联网。")
        except (OSError, ValueError) as error:
            self.status_label.set_text(str(error))

    def diagnostics(self):
        action_log("diagnostic dialog opened")
        path = Path("/var/log/a20/wifi.log")
        try:
            with path.open("rb") as stream:
                stream.seek(0, 2)
                size = stream.tell()
                stream.seek(max(0, size - 16384))
                content = stream.read(16384).decode("utf-8", "replace")
        except OSError:
            content = "尚未找到无线服务日志。请检查本次镜像的无线服务是否启动。"
        dialog = Gtk.Dialog(title="无线诊断日志", transient_for=self, modal=True)
        dialog.set_default_size(720, 420)
        dialog.add_button("关闭", Gtk.ResponseType.CLOSE)
        text = Gtk.TextView()
        text.set_editable(False)
        text.set_monospace(True)
        text.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        text.get_buffer().set_text(f"{path}\n\n{content}")
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(text)
        dialog.get_content_area().pack_start(scroll, True, True, 8)
        dialog.show_all()
        run_dialog(dialog)
        dialog.destroy()
        action_log("diagnostic dialog closed")


class WifiApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.a20os.Wifi", flags=Gio.ApplicationFlags.FLAGS_NONE)
    def do_activate(self):
        window = self.get_active_window() or WifiWindow(self)
        window.present()


def main():
    application = WifiApplication()
    application.register(None)
    application.activate()
    # Match the desktop's other Python GTK services: avoid MainLoop's
    # Python signal wakeup-fd integration on the A20OS Linux ABI.
    context = GLib.MainContext.default()
    while application.get_windows():
        context.iteration(True)


if __name__ == "__main__":
    main()
