[binaries]
c = 'riscv64-unknown-elf-gcc'
cpp = 'riscv64-unknown-elf-g++'
ar = 'riscv64-unknown-elf-ar'
strip = 'riscv64-unknown-elf-strip'
objcopy = 'riscv64-unknown-elf-objcopy'

[host_machine]
system = 'a20'
cpu_family = 'riscv64'
cpu = 'riscv64'
endian = 'little'

[built-in options]
c_args = ['-march=rv64gc', '-mabi=lp64d', '-mcmodel=medany', '-fno-stack-protector', '-D_GNU_SOURCE', '-D__INT_FAST8_TYPE__=signed char', '-D__INT_FAST16_TYPE__=long', '-D__INT_FAST32_TYPE__=long', '-D__UINT_FAST8_TYPE__=unsigned char', '-D__UINT_FAST16_TYPE__=unsigned long', '-D__UINT_FAST32_TYPE__=unsigned long']
cpp_args = ['-march=rv64gc', '-mabi=lp64d', '-mcmodel=medany', '-fno-stack-protector', '-D_GNU_SOURCE', '-D__INT_FAST8_TYPE__=signed char', '-D__INT_FAST16_TYPE__=long', '-D__INT_FAST32_TYPE__=long', '-D__UINT_FAST8_TYPE__=unsigned char', '-D__UINT_FAST16_TYPE__=unsigned long', '-D__UINT_FAST32_TYPE__=unsigned long']
c_link_args = ['-march=rv64gc', '-mabi=lp64d', '-nostdlib']
cpp_link_args = ['-march=rv64gc', '-mabi=lp64d', '-nostdlib']
